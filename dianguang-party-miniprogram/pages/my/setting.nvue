<template><view class="m-page"><view class="m-top"><text class="m-kicker">ACCOUNT SETTINGS</text><text class="m-title">账号设置</text><text class="m-subtitle">当前为本地调试环境</text></view><view class="m-card"><text class="m-heading">电光党建</text><text class="m-muted">个人资料与密码可在“我的”页面管理。退出后，本机登录信息将被清除。</text></view><button class="m-primary" @click="ToLogin">退出登录</button></view></template><script>import {clearSession} from "@/utils/session";export default {methods:{ToLogin(){uni.showModal({title:'退出登录',content:'确认退出当前账号？',success:res=>{if(res.confirm){clearSession();this.$store.state.user=[];this.$store.state.token='';uni.reLaunch({url:'/pages/login/login'})}}})}}}</script>