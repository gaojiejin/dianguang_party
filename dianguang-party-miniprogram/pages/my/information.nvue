<template><view class="m-page"><view class="u-page-title">个人信息</view><view class="m-card"><view v-for="row in rows" :key="row.label" class="u-info-row"><text>{{row.label}}</text><text>{{row.value||'未填写'}}</text></view></view></view></template><script>export default {computed:{rows(){const u=this.$store.state.user||{};return [{label:'姓名',value:u.name},{label:'学号 / 工号',value:u.jobId},{label:'身份',value:u.role},{label:'所属支部',value:this.$store.getters.getBranchName(u.branchId)},{label:'岗位',value:u.post},{label:'手机号',value:u.phone},{label:'院系',value:u.department},{label:'年级',value:u.grade}]}}}</script>