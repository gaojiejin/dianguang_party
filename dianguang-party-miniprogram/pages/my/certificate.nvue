<template><view class="m-page"><view class="u-page-title">学习证明</view><view class="m-card"><text class="m-muted">请选择证明所需的培训日期。是否可导出以后台学习完成记录为准。</text><view class="m-field"><text>开始日期</text><picker mode="date" :value="start" @change="start=$event.detail.value"><view class="u-date">{{start}}</view></picker></view><view class="m-field"><text>完成日期</text><picker mode="date" :value="end" @change="end=$event.detail.value"><view class="u-date">{{end}}</view></picker></view><button class="m-primary" :loading="busy" :disabled="busy" @click="download">导出学习证明</button><text v-if="error" class="u-error">{{error}}</text></view></view></template><script>
import request from '@/api/index';
const date=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
export default {data:()=>({start:date(),end:date(),busy:false,error:''}),methods:{async download(){if(this.busy)return;if(this.start>this.end)return uni.showToast({title:'开始日期不能晚于完成日期',icon:'none'});this.busy=true;this.error='';try{const result=await request({url:'classLearnInfo/exportCertificate',method:'POST',data:{job_id:uni.getStorageSync('job_id'),start_time:this.start,completion_time:this.end,export_time:date()}});if(typeof result!=='string'||!/^https?:\/\//.test(result))throw new Error(result||'证明生成失败');const download=await new Promise((resolve,reject)=>uni.downloadFile({url:result,header:{Authorization:uni.getStorageSync('token')||''},success:resolve,fail:reject}));if(download.statusCode!==200)throw new Error('下载失败，请重试');await new Promise((resolve,reject)=>uni.openDocument({filePath:download.tempFilePath,fileType:'pdf',showMenu:true,success:resolve,fail:reject}))}catch(e){this.error=e.message||'证明打开失败，请重试'}finally{this.busy=false}}}}
</script>