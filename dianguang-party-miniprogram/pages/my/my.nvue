<template>
 <view class="m-page r-original r-my">
  <view class="r-profile-header"><view class="r-avatar" @click="avatarClick"><image v-if="user.portrait&&!broken" :src="user.portrait" mode="aspectFill" @error="broken=true"/><party-icon v-else type="person-filled" size="42" color="#fff"/></view><view class="r-profile-copy"><text class="r-profile-name">{{user.name}}</text><text>{{$store.getters.getBranchName(user.branchId)||'未分配支部'}}</text><text>{{user.jobId}} · {{user.role}}</text></view></view>
  <view class="r-profile-row" @click="open('information')"><view class="r-profile-icon"><party-icon type="person" size="24" color="#C91010"/></view><text>个人信息</text><party-icon type="right" size="17" color="#a1acbb"/></view>
  <view class="r-profile-row" @click="open('myparty')"><view class="r-profile-icon"><party-icon type="staff" size="24" color="#C91010"/></view><text>支部通讯录</text><party-icon type="right" size="17" color="#a1acbb"/></view>
  <view v-if="user.role==='积极分子'" class="r-profile-row" @click="open('certificate')"><view class="r-profile-icon"><party-icon type="medal" size="24" color="#C91010"/></view><text>我的学习证明</text><party-icon type="right" size="17" color="#a1acbb"/></view>
  <view class="r-profile-row" @click="open('changepwd')"><view class="r-profile-icon"><party-icon type="locked" size="24" color="#C91010"/></view><text>修改密码</text><party-icon type="right" size="17" color="#a1acbb"/></view>
  <view class="r-profile-row" @click="open('setting')"><view class="r-profile-icon"><party-icon type="gear" size="24" color="#C91010"/></view><text>系统设置</text><party-icon type="right" size="17" color="#a1acbb"/></view><userTabbar :managerValue="2"/>
 </view>
</template>
<script>
import userTabbar from '@/component/userTabbar.vue';
import request,{getBase_url} from '@/api/index';
export default {
 components:{userTabbar},
 data:()=>({broken:false,uploading:false}),
 computed:{user(){return this.$store.state.user||{}}},
 methods:{
  open(page){if(page==='myparty'&&!this.user.branchId)return uni.showToast({title:'尚未分配支部',icon:'none'});uni.navigateTo({url:'/pages/my/'+page})},
  avatarClick(){
   if(this.uploading)return;
   uni.chooseImage({count:1,sizeType:['compressed'],success:res=>{
    this.uploading=true;
    uni.uploadFile({url:getBase_url()+'user/uploadAvatar',name:'avatar',filePath:res.tempFilePaths[0],header:{Authorization:uni.getStorageSync('token')||''},formData:{job_id:uni.getStorageSync('job_id')},
     success:async upload=>{try{if(upload.statusCode!==200)throw new Error();const user=await request({url:'user/queryByJobID',data:{job_id:uni.getStorageSync('job_id')}});delete user.password;this.$store.state.user=user;uni.setStorageSync('user',user);this.broken=false;uni.showToast({title:'头像已更新'})}catch(e){uni.showToast({title:'头像更新失败，请重试',icon:'none'})}},
     fail:()=>uni.showToast({title:'上传失败，请重试',icon:'none'}),complete:()=>{this.uploading=false}
    });
   }});
  }
 }
}
</script>
