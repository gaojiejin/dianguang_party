<template><view class="m-page"><view class="u-profile"><view class="m-profile-avatar" @click="avatarClick"><image v-if="user.portrait&&!broken" :src="user.portrait" mode="aspectFill" @error="broken=true"/><text v-else>{{user.name?user.name.slice(0,1):'我'}}</text></view><view><text class="m-heading">{{user.name}}</text><text class="m-muted">{{user.role}} · {{user.jobId}}</text><text class="m-muted">{{$store.getters.getBranchName(user.branchId)||'未分配支部'}}</text></view></view><view class="m-card m-profile-links"><view @click="open('information')"><text>个人信息</text><text>›</text></view><view @click="open('myparty')"><text>支部通讯录</text><text>›</text></view><view v-if="user.role==='积极分子'" @click="open('certificate')"><text>学习证明</text><text>›</text></view><view @click="open('changepwd')"><text>修改密码</text><text>›</text></view><view @click="open('setting')"><text>设置</text><text>›</text></view></view><userTabbar :managerValue="2"/></view></template>
<script>
import userTabbar from '@/component/userTabbar.vue';
import request,{getBase_url} from '@/api/index';
export default {
 components:{userTabbar},
 data:()=>({broken:false,uploading:false}),
 computed:{user(){return this.$store.state.user||{}}},
 methods:{
  open(page){if(page==='myparty'&&!this.user.branchId)return uni.showToast({title:'尚未分配支部',icon:'none'});uni.navigateTo({url:'/pages/my/'+page})},
  avatarClick(){
   if(this.uploading)return;
   uni.chooseImage({count:1,sizeType:['compressed'],success:res=>{
    this.uploading=true;
    uni.uploadFile({url:getBase_url()+'user/uploadAvatar',name:'avatar',filePath:res.tempFilePaths[0],header:{Authorization:uni.getStorageSync('token')||''},formData:{job_id:uni.getStorageSync('job_id')},
     success:async upload=>{try{if(upload.statusCode!==200)throw new Error();const user=await request({url:'user/queryByJobID',data:{job_id:uni.getStorageSync('job_id')}});delete user.password;this.$store.state.user=user;uni.setStorageSync('user',user);this.broken=false;uni.showToast({title:'头像已更新'})}catch(e){uni.showToast({title:'头像更新失败，请重试',icon:'none'})}},
     fail:()=>uni.showToast({title:'上传失败，请重试',icon:'none'}),complete:()=>{this.uploading=false}
    });
   }});
  }
 }
}
</script>
