<template><view class="m-page"><view class="u-page-title">支部通讯录</view><view class="m-search"><input v-model="keyword" placeholder="搜索姓名"/></view><view v-if="error" class="u-state"><text>{{error}}</text><button class="m-small-button" @click="load">重试</button></view><view v-for="member in visible" :key="member.id" class="u-member"><text class="u-member-avatar">{{(member.name||'').slice(0,1)}}</text><view><text class="m-heading">{{member.name}}</text><text class="m-muted">{{member.post || member.role}}</text></view></view><view v-if="!error&&!visible.length" class="m-empty">暂无相关成员</view></view></template><script>import request from '@/api/index';export default {data:()=>({members:[],keyword:'',error:''}),computed:{visible(){return this.members.filter(m=>(m.name||'').includes(this.keyword))}},onLoad(){this.load()},methods:{async load(){this.error='';try{const id=this.$store.state.user.branchId;if(!id)throw new Error('尚未分配支部');this.members=await request({url:'branch/getUsersByBranchID',method:'POST',data:{branch_id:id}})}catch(e){this.error=e.message}}}}</script>