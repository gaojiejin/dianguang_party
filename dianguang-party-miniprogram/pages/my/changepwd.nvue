<template><view class="m-page"><view class="u-page-title">修改密码</view><view class="m-card"><view class="m-field"><text>当前密码</text><input v-model="oldPassword" password placeholder="请输入当前密码"/></view><view class="m-field"><text>新密码</text><input v-model="newPwd" password placeholder="请输入新密码"/></view><view class="m-field"><text>确认新密码</text><input v-model="confirmPassword" password placeholder="再次输入新密码"/></view><button class="m-primary" :loading="busy" :disabled="busy" @click="submit">确认修改</button><text v-if="error" class="u-error">{{error}}</text></view></view></template><script>import request from '@/api/index';import {clearSession} from '@/utils/session';export default {data:()=>({oldPassword:'',newPwd:'',confirmPassword:'',busy:false,error:''}),methods:{async submit(){if(this.busy)return;if(!this.oldPassword||!this.newPwd)return uni.showToast({title:'请填写完整密码',icon:'none'});if(this.newPwd!==this.confirmPassword)return uni.showToast({title:'两次新密码不一致',icon:'none'});this.busy=true;this.error='';try{const result=await request({url:'user/updatePasswordByPrePwd',method:'POST',data:{inputPwd:this.oldPassword,newPwd:this.newPwd,job_id:uni.getStorageSync('job_id')}});if(result!=='密码修改成功')throw new Error(result);clearSession();this.$store.state.user={};uni.showToast({title:'修改成功，请重新登录',icon:'none'});uni.reLaunch({url:'/pages/login/login'})}catch(e){this.error=e.message}finally{this.busy=false}}}}</script>