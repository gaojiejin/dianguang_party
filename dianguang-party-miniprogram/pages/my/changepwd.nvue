  padding: 5%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.user-name {
  margin-top: 14rpx;
  font-size: 18px;
  font-weight: bold;
  color: #333;
}

.form {
  width: 100%;
}

.input-group {
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
}

.label {
  margin-bottom: 14rpx;
  font-size: 14px;
  color: #666;
}

input {
  width: 100%;
  height: 40px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 16px;
}

.button-group {
  margin-top: 42rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.submit-button {
  width: 80%;
  height: 45px;
  background-color: #007AFF;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  line-height: 45px;
}


</style>