<template>
  <view class="container">
    <!-- 用户头像和信息展示 -->
    <view class="header">
      <u-avatar :src="user.portrait" shape="circle" size="140rpx"></u-avatar>
      <text class="user-name">{{ user.name }}</text>
    </view>

    <!-- 密码修改表单 -->
    <view class="form">
      <view class="input-group">
        <text class="label" style="margin-top: 5%; font-weight: bold; color: black; margin-left: 3%;">请输入当前密码：</text>
        <input type="password" style="border: 1px solid black; margin-left: 3%; width: 94%; border-radius: 20px;" v-model="oldPassword"/>
      </view>      
	  <view class="input-group">
        <text class="label" style="margin-top: 5%; font-weight: bold; color: black; margin-left: 3%;">请输入新的密码：</text>
        <input type="password" style="border: 1px solid black; margin-left: 3%; width: 94%; border-radius: 20px;" v-model="newPwd"/>
      </view>
      <view class="input-group">
        <text class="label" style="margin-top: 5%; font-weight: bold; color: black; margin-left: 3%;">再次输入新的密码：</text>
        <input type="password" style="border: 1px solid black; margin-left: 3%; width: 94%; border-radius: 20px;" v-model="confirmPassword"/>
      </view>

      <!-- 提交按钮 -->
      <view class="button-group">
        <button @click="submitPassword" class="submit-button"  style="margin-top: 5%; background: red;  border-radius: 20px;">确认修改</button>
      </view>
    </view>
  </view>
</template>

<script>
import { getBase_url } from '../../api';
import { updatePasswordByPrePwd } from '@/api/api.js';
  export default {
    data() {
      return {
        user: {},
        newPwd: '',
		oldPassword:'',
        confirmPassword: '',
      };
    },
    onLoad(options) {
      if (options.user) {
        this.user = JSON.parse(decodeURIComponent(options.user));
      } else {
        console.error("User信息缺失");
      }
    },
	methods: {
	  submitPassword() {
		// 检查新密码和确认密码是否一致
		if (this.newPwd !== this.confirmPassword) {
		  uni.showToast({
			title: '两次密码不一致',
			icon: 'none',
			duration: 1000,
		  });
		  return;
		}
		console.log(this.oldPassword)
		console.log(this.newPwd)
		// 提交密码更新请求
		var data={
			inputPwd: this.oldPassword,  // 原密码
			newPwd: this.newPwd,      // 新密码
			job_id: uni.getStorageSync('job_id')  
		}
		updatePasswordByPrePwd(data).then((res)=>{
			console.log(res)
			if (res === '密码修改成功'){
				uni.showToast({
					title: '密码修改成功,请重新登录',
					icon: 'none'
				})	
				setTimeout(() => {
					uni.clearStorageSync();
					uni.redirectTo({
						url: '/pages/login/login'
					})
				}, 1000);
			}
			else{
				uni.showToast({
					title: res,
					icon: 'none'
				})	
			}
			
		})
	  }
	}
  }
</script>

<style scoped>
