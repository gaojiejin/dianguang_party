<template><view class="m-page"><view class="m-top"><text class="m-kicker">LEARN · THINK · PRACTICE</text><text class="m-title">学习中心</text><text class="m-subtitle">把每一次学习，积累成前行的力量</text></view><view class="m-card m-study-summary"><view><text class="m-muted">个人学习进度</text><text class="m-progress-number">{{learn.shouldLearned ? Math.round(learn.alreadyLearned*100/learn.shouldLearned) : 0}}<text>%</text></text></view><view><text class="m-stat">{{learn.alreadyLearned || 0}} / {{learn.shouldLearned || 0}}</text><text class="m-muted">已完成 / 应学习课程</text></view></view><view class="m-tabs"><view v-for="(tab,index) in tabList" :key="index" :class="['m-tab',currentTab===index?'m-tab-active':'']" @click="changeTab(index)">{{tab}}</view></view><view class="m-search"><input v-model="searchQuery" placeholder="搜索课程名称"/></view><view v-for="(item,index) in courses" :key="item.classId"><view v-if="item.authority===currentTab && (!searchQuery || item.classTitle.indexOf(searchQuery)>-1)" class="m-course" @click="ToLearnDetail(index)"><image v-if="item.classPortrait" :src="item.classPortrait" mode="aspectFill"/><view v-else class="m-course-icon">学</view><view class="m-course-copy"><text class="m-heading">{{item.classTitle}}</text><text class="m-muted">{{item.department || '电光学院'}} · 专题学习</text></view><text class="m-course-arrow">›</text></view></view><view v-if="!courses.length" class="m-empty">暂无课程，稍后再来看看</view><managerTabbar :managerValue="currentValue"/></view></template>
<script>
	import managerTabbar from '@/component/managerTabbar.vue'
	import { getClasses, getOwnLearnInfo } from '@/api/api.js'

	export default {
		components: {
			managerTabbar
		},
		data() {
			return {
				currentValue: 1,
				searchQuery: '',
				currentTab: 0,  // 当前选中的标签页
				courses: [],
				tabList: ['党员学习', '积极分子学习'],  // 标签名称
				// 新增的变量
				name: '个人学习统计',  
				percent: 75,  
				learn: '',
			}
		},
		onLoad() {
			
		},
		onShow() {
            if(this.$store.state.user.role==='积极分子') this.currentTab=1;
			var data = {
				user_id : this.$store.state.user.id
			}
			getOwnLearnInfo(data).then((res)=>{
				this.learn = res
				this.percent = this.learn.shouldLearned ? Math.round(this.learn.alreadyLearned * 1000 / this.learn.shouldLearned) / 10 : 0;
			})
			getClasses().then((res) => {
				console.log(res)
				this.courses = (res || []).slice().sort((a,b)=>b.classId-a.classId);
			});
		},
		methods: {
			onSearchInput(value) {
				this.searchQuery = value;
			},
			changeTab(index) {
				this.currentTab = index;
			},
			ToLearnDetail(index) {
				if (this.currentTab === 0 && this.$store.state.user.role === '积极分子'){
					uni.showToast({
						title: '无权限学习',
						icon: 'error'
					})	
				}
				else if (this.currentTab === 1 && this.$store.state.user.role !== '积极分子'){
					uni.showToast({
						title: '无权限学习',
						icon: 'error'
					})	
				}
				else{
					uni.navigateTo({
						url: `/pages/manager/learn/learnDetail?course=${encodeURIComponent(JSON.stringify(this.courses[index]))}`
					});
				}		
			}
		}
	}
</script>