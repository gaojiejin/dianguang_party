}
.photo{
	width: 100%;
	background-color: white;
}
.btn{
	width: 100%; 
	height: 98rpx; 
	margin-top: 98rpx;
	background-color: #fc4c34; 
	color: white; 
	text-align: center; 
	position: fixed; 
	bottom: 0;
}
