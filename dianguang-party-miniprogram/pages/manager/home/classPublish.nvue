<template>
	<view>
		<view class="title">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">课程标题</view>
				<input style="width: 55%; height: 84rpx; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入标题" type="text" v-model="title" />	
			</view>		
		</view>
		
		<view class="department">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">所属学院</view>
				<input style="width: 55%; height: 84rpx; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入部门" type="text" v-model="department" />	
			</view>		
		</view>
		
		<view class="classify">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row;  border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">课程分类</view>
				<view style="width: 55%; text-align: right; height: 84rpx; line-height: 84rpx; margin-right: 2.5%;">
					<picker @change="courseChange" :value="index" :range="courses" v-model="course_index" style="width: 100%;">
						<view  style="text-align: right; margin-right: 2.5%;" >{{courses[course_index]}}</view>
					</picker>
				</view>
			</view>		
		</view>
		
		<view class="photo">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">上传课程头像</view>
			</view>
			<view style="margin-left: 5%;">
				<uni-file-picker
				v-model="Value" 
				fileMediatype="image"  
				limit="1" 
				@progress="onProgress"
				@success="onSuccess"
				@fail="onFail"
				@select="onSelect"
				></uni-file-picker>
			</view>
			<view style="height: 42rpx;"></view>
		</view>
		<view style="height: 112rpx;"></view>
		<button class="btn" @click="submit()">创建课程</button>
	</view>
</template>

<script>
	import { getClasses, addChapter } from '@/api/api.js'
	import { getBase_url } from '@/api/index.js'
	export default {
		data (){
			return{
				title: '',
				department: '',
				Value: [],			
				imageUrl: '',
				
				course_index: 0,
				course_tpye: '党员学习',
				courses: ['党员学习', '积极分子学习'],
			}
		},
		onLoad() {

		},
		methods: {
			courseChange: function(event) {
				this.course_index = event.detail.value
				this.course_type = this.courses[this.course_index]
			},
			onProgress(event){
				console.log('process')
			},
			onSuccess(res){
				console.log('success')
			},
			onFail(err){
				console.log('fail')
			},
			onSelect(res){
				console.log(res.tempFilePaths[0])
				this.imageUrl = res.tempFilePaths[0] 
			},
			submit(){
				if (this.title === ''){
					uni.showToast({
						title: '标题不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else if (this.department === '') {
					uni.showToast({
						title: '部门不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else if (this.imageUrl === ''){
					uni.showToast({
						title: '课程图片不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else{
					uni.uploadFile({
						url: getBase_url() + 'class/addClass',
						filePath: this.imageUrl,
						name: 'class_portrait',
						formData: {
							founder: this.$store.state.user.name,
							founder_id: this.$store.state.user.id,
							class_title: this.title,
							department: this.department,
							authority: this.course_index
						}, 
						header:{
							'Authorization': uni.getStorageSync('token') || '',
							'Content-Type': 'multipart/form-data' // 指定内容类型为 multipart/form-data
						},		
						success: (res) => {
							console.log(res)
							if (res.data === '成功创建课程'){
								uni.showToast({
									title: res.data,
									icon: 'none'
								})	
								setTimeout(() => {
									uni.switchTab({
										url:`/pages/manager/home/home`
									})
								}, 1000);	
							}
							else{
								uni.showToast({
									title: res.data,
									icon: 'none'
								})	
							}						
						},
						fail: (err) => {
							uni.showToast({
								title: '上传课程失败',
								icon: 'none'
							})
							console.error(err);
						},
					});
						
				}
			}
		}
	}
</script>

