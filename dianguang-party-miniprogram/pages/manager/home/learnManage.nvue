<template>
	<view>
		<view style="height: 25vh; width: 100%; background-color: white; display: flex; flex-direction: row;">
			<view style="height: 20vh; margin-top: 49rpx; width: 30%; margin-left: 5%;">
				<l-circularProgress box-height="150" box-width="150"  progressColor="#1684fc" :lineWidth="15" font-size="15" gradualColor="#1684fc" :percent="percent">
			
				</l-circularProgress>
			</view>
			<view style="height: 20vh; margin-top: 35rpx; width: 50%; margin-left: 5%;">
				<view style="height: 5vh; width: 100%; line-height: 70rpx; font-size: 35rpx; font-weight: bold; text-align: center;" @click='Tochange()' >学习统计数据</view>
				<view>
					<picker @change="handleChange" :value="index" :range="learnRateStatistics.map(item => item.learn_class.classTitle)" v-model="learn_type" style="width: 100%;">
						<view style="width: 75%; margin-left: 25%; text-align: center; font-size: 28rpx; margin-top: 14rpx; height: 3vh; line-height: 42rpx; display: flex; flex-direction: row;" >
							<view style="max-width: 80%; overflow-x: auto; white-space: nowrap;">
								{{learnRateStatistics[index].learn_class.classTitle}}
							</view>
							<image src="/static/manager/home/下.svg" style="margin-left: 1%; width: 10%; height: 3vh;"></image>
						</view>
					</picker>
				</view>
				<view style="width: 75%; margin-top: 14rpx; margin-left: 25%; height: 4vh; line-height: 56rpx; display: flex; flex-direction: row;" >
					<image src="/static/manager/home/蓝圆点.png" style="height: 2vh; margin-top: 14rpx;" mode="heightFix"></image>
					<view style="margin-left: 5%; height: 4vh; line-height: 56rpx;">总人数</view>
					<view style="margin-left: 5%; height: 4vh; line-height: 56rpx;">
						{{learnRateStatistics[index].num}} 人
					</view>	
				</view>
				<view style="width: 75%; margin-left: 25%; height: 4vh; line-height: 56rpx; display: flex; flex-direction: row;">
					<image src="/static/manager/home/灰圆点.png" style="height: 2vh; margin-top: 14rpx;" mode="heightFix"></image>
					<view style="margin-left: 5%; height: 4vh; line-height: 56rpx;">未完成</view>
					<view style="margin-left: 5%; height: 4vh; line-height: 56rpx;">
						{{learnRateStatistics[index].num - learnRateStatistics[index].finishNum}} 人
					</view>
				</view>
				<view style="width: 100%; text-align: center; height: 4vh; line-height: 56rpx;">
				    <button @click="exportLearningStatistics" 
				            style="padding: 0px; background-color: #007bff; width: 70%; color: white; border-radius: 6px; font-size: 28rpx; cursor: pointer; height: 4vh; line-height: 56rpx; text-align: center; margin: 0 auto;">
				        导出总学习情况
				    </button>
				</view>
			</view>
		</view>
		<view style="height: 6vh; line-height: 84rpx; width: 100%;">
		      <uni-search-bar
		        placeholder="搜索"
		        :modelValue="searchQuery"
				cancelButton='none'
		        @input="onSearchInput"
		      />
		</view>
		<!-- 自定义 Tab 控制区域 -->
		<view class="tab">
			<view v-for="(tab, index) in tabList" :key="index" :class="{active: currentTab === index}" @click="changeTab(index)" class="tabitem">
				{{ tab }}
				<view v-if="currentTab === index" style="height: 2px; background-color: #FF6A6A; width: 100%; margin-top: 2px;"></view>
			</view>
		</view>
		<view v-for="(item,index) in learnRateStatistics" :key="index" >
			<view v-if="searchQuery === '' || item.learn_class.classTitle.includes(searchQuery)">
				<view v-if="item.learn_class.authority === currentTab">
					<view style="height: 12vh; width: 100%; border-radius: 10px;  background-color: white; margin-top: 28rpx;"  @click="toggleExpand(index)">
						<view style="width: 100%; height: 10vh; margin-left: 3%; margin-top: 14rpx; display: flex; flex-direction: row;">
							<view style="margin-top: 14rpx;">
								<u-avatar :src="item.learn_class.classPortrait" shape="square" size="8vh"></u-avatar>	
							</view>	
							<view style="margin-top: 14rpx; margin-left: 5%; width: 65%;">
								<view style="height: 4vh; line-height: 56rpx; font-size: 35rpx; overflow-x: auto; white-space: nowrap;">{{item.learn_class.classTitle}}</view>
								<view style="height: 4vh; line-height: 56rpx; font-size: 25.2rpx; color: gray;">{{item.learn_class.department}}</view>		
							</view>
							<image src="/static/manager/home/下.svg" style="height: 2vh; width: 10%; margin-top: 56rpx;"></image>			
						</view>
					</view>
					<transition name="expand">
						<view v-show="expandedList[index]">
							<view v-for="(item2,index2) in learnRateStatistics[index].branches" :key="index2" @click="ToLearnDetail(index, index2)">
								<view style="width: 90%; margin-left: 5%; height: 16vh; margin-top: 14rpx; background-color: white; border-radius: 20px;">
									<view style="width: 90%; height: 6vh; line-height: 84rpx; margin-left: 5%; border-bottom: 1px solid #e8e8e8; font-size: 30.8rpx; font-weight: bold;">
										{{ item2.branch.branchName}}
									</view>
									<view style="width: 90%; margin-left: 5%; height: 10vh; display: flex; flex-direction: row;">
										<view style="width: 25%; height: 9vh;">
											<view style="height: 6vh; line-height: 84rpx; color: black; font-size: 42rpx; text-align: center;">
												{{ item2.num}}
											</view>
											<view style="height: 3vh; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
												支部总人数
											</view>
										</view>
										<view style="width: 25%; height: 9vh;">
											<view style="height: 6vh; line-height: 84rpx; color: #fccc08; font-size: 42rpx; text-align: center;">
												{{ item2.finishNum}}
											</view>
											<view style="height: 3vh; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
												完成人数
											</view>
										</view>
										<view style="width: 25%; height: 9vh;">
											<view style="height: 6vh; line-height: 84rpx; color: #ff2020; font-size: 42rpx; text-align: center;">
												{{item2.num - item2.finishNum}}
											</view>
											<view style="height: 3vh; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
												未完成人数
											</view>
										</view>
										<view style="width: 25%; height: 9vh;">
											<view style="height: 6vh; line-height: 84rpx; color: #c3dba0; font-size: 42rpx; text-align: center;">
												{{Math.round(item2.finishNum*1000/item2.num)/10}}%
											</view>
											<view style="height: 3vh; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
												完成率
											</view>
										</view>
									</view>
								</view>	
							</view>
						</view>			
					</transition>
				</view>	
			</view>
		</view>
		<view style="height: 3vh;"></view>
	</view>
</template>

<script>
import { getBranches } from '@/api/api.js';
import { getBase_url } from '@/api/index.js';
import { getLearnRateStatistics, exportLearnRateStatistics } from '@/api/api.js';

export default {
  data() {
    return {
      percent: 75,
      searchQuery: '',
      tabList: ['党员学习', '积极分子学习'],  // 标签名称
      index: 0,
      expandedList: [],
      learn_type: '大学习第一期',
      isOpen: false,
      branches: [],
      learnRateStatistics: [],  // 原有学习统计数据
      currentTab: 0  // 当前选中的标签页
    };
  },
  // computed: {
  //   // 计算属性：根据当前选中的tab筛选learn_class数据
  //   filteredLearnRateStatistics() {
  //     // 首先根据 currentTab 筛选出符合当前标签的课程
  //     const filteredByTab = this.learnRateStatistics.filter(item => {
  //       return item.learn_class.authority === this.currentTab;  // 根据 learn_class.authority 字段判断
  //     });

  //     // 然后根据 searchQuery 进一步筛选课程标题
  //     if (this.searchQuery) {
  //       return filteredByTab.filter(item =>
  //         item.learn_class.classTitle.includes(this.searchQuery)
  //       );
  //     }
      
  //     return filteredByTab;
  //   }
  // },
  onLoad() {
    getBranches().then(res => {
      this.branches = res.map(branch => branch.branch_name); 
    }).catch(error => {
      console.error('获取支部列表失败:', error);
    });

    // 获取学习统计数据
    getLearnRateStatistics().then((res) => {
      if (res !== null) {
        this.learnRateStatistics = res;
        this.expandedList = this.learnRateStatistics.map(() => false);
        this.learn_type = this.learnRateStatistics[this.index].learn_class.classTitle;
        this.percent = Math.round(this.learnRateStatistics[this.index].finishNum * 1000 / this.learnRateStatistics[this.index].num) / 10;
      }
    });
  },
  methods: {
    handleChange(event) {
      this.index = event.detail.value;
      this.learn_type = this.learnRateStatistics[this.index].learn_class.classTitle;
      this.percent = Math.round(this.learnRateStatistics[this.index].finishNum * 1000 / this.learnRateStatistics[this.index].num) / 10;
    },
    onSearchInput(value) {
      this.searchQuery = value;
    },
    toggleExpand(index) {
      this.expandedList[index] = !this.expandedList[index];
      this.isOpen = !this.isOpen;
    },
    ToLearnDetail(index, index2) {
      uni.navigateTo({
        url: `/pages/manager/home/learnDetail?class_id=${encodeURIComponent(JSON.stringify(this.learnRateStatistics[index].learn_class.classId))}&branch_id=${encodeURIComponent(JSON.stringify(this.learnRateStatistics[index].branches[index2].branch.branchId))}`,
      });
    },
    Tochange() {
      uni.navigateTo({
        url: `/pages/manager/home/changeLearn`
      });
    },
    changeTab(index) {
      this.currentTab = index;  // 更新当前选中的 tab，控制数据显示
    },
    // 导出学习情况统计
    exportLearningStatistics() {
      uni.navigateTo({
        url: `/pages/manager/home/exportpartyLearnrate`
      });
    }
  }
};
</script>




<style >
.expand-enter-active, .expand-leave-active {
  transition: all 0.5s ease;
}

.expand-enter, .expand-leave-to /* .expand-leave-active in <2.1.8 */ {
  max-height: 0;
  opacity: 0;
}
.active {
		color: #FF6A6A; /* 选中时文字颜色 */
		font-weight: bold;
	}

	.tab {
		width: 100%;
		margin-top: 14rpx;
		display: flex;
		flex-direction: row;
		border-bottom: 1px solid #eaeaea;
	}

	.tabitem {
		flex: 1; /* 确保每个标签均匀分布 */
		text-align: center;
		font-size: 14px;
		padding-bottom: 10px;
		color: #333;
		position: relative; /* 保证子元素可以相对定位 */
	}

	.tabitem.active {
		color: #FF6A6A;
		font-weight: bold;
	}
</style>