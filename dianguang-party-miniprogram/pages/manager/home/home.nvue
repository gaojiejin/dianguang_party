<template>
	<view>
		<uni-swiper-dot class="uni-swiper-dot-box" @clickItem=clickItem :info="swipers" :current="current" :mode="mode"
			:dots-styles="dotsStyles" field="content">
			<swiper class="swiper-box" @change="change" :current="swiperDotIndex" :autoplay="autoplay" :interval="interval" :circular="circular">
				<swiper-item v-for="(item, index) in swipers" :key="index">
					<view class="swiper-item" :class="'swiper-item' + index">
						<image :src="item.url" style="width: 100%;"></image>
					</view>
				</swiper-item>
			</swiper>
		</uni-swiper-dot>
		<view style="width: 100%; background-color: white;">
			<view style="font-size: 35rpx; font-weight: bold;margin-left: 3%; margin-top: 5%; color: #e2544a;">内容发布</view>
		</view>
		<view>
			<view class="content">
				<view v-for="(item,index) in content" :key="index" @click="contentPublish(index)" style="width: 20%;">
					<view v-if="index === 2" style="height: 112rpx; width: 70%; margin-left: 15%;margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
						<image :src="item.url" style="width: 100%; margin-left:0%; margin-top: 22.4rpx; height: 70rpx;"></image>
					</view>
					<view v-else style="height: 112rpx; width: 70%; margin-left: 15%;margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
						<image :src="item.url" style="width: 60%; margin-left: 22%; margin-top: 22.4rpx; height: 70rpx;"></image>
					</view>
					<view class="vi-item">{{item.title}}</view>
				</view>
			</view>			
		</view>
		<view style="width: 100%; background-color: white;">
			<view style="font-size: 35rpx; font-weight: bold;margin-left: 3%; margin-top: 5%; color: #e2544a;">支部管理</view>
		</view>
		<view>
			<view class="content" >
				<view v-for="(item,index) in party" :key="index" @click="partyManage(index)" style="width: 20%;">
					<view v-if="index === 2" style="height: 112rpx; width: 70%; margin-left: 15%;margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
						<image :src="item.url" style="width: 80%; margin-left: 10%; margin-top: 0rpx; height: 84rpx;"></image>
					</view>
					<view v-else style="height: 112rpx; width: 70%; margin-left: 15%;margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
						<image :src="item.url" style="width: 80%; margin-left: 10%; margin-top: 14rpx; height: 84rpx;"></image>
					</view>
					<view class="vi-item">{{item.title}}</view>
				</view>
			</view>
		</view>
		<view style="width: 100%; background-color: white;">
			<view style="font-size: 35rpx; font-weight: bold;margin-left: 3%; margin-top: 5%; color: #e2544a;">学习管理</view>
		</view>
		<view>
			<view class="content">
				<view v-for="(item,index) in learn" :key="index" @click="learnManage(index)" style="width: 20%;">
					<view v-if="index === 0" style="height: 112rpx; width: 70%; margin-left: 15%;margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
						<image :src="item.url" style="width: 80%; margin-left: 10%; margin-top: 14rpx; height: 84rpx;"></image>
					</view>
					<view v-else style="height: 112rpx; width: 70%; margin-left: 15%;margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
						<image :src="item.url" style="width: 60%; margin-left: 20%; margin-top: 14rpx; height: 84rpx;"></image>
					</view>
					<view class="vi-item">{{item.title}}</view>
				</view>
			</view>
		</view>	
		<view style="width: 100%; background-color: white;">
			<view style="font-size: 32.2rpx; font-weight: bold; margin-left: 3%; margin-top: 5%;"></view>
		</view>
		<managerTabbar :managerValue="currentValue" style="height: 42rpx; margin-top: 42rpx;"></managerTabbar>
	</view>	
</template>

<script>
	import myTable from '@/component/myTable.vue'
	import managerTabbar from '@/component/managerTabbar.vue'
	import { queryIDNameMapping, getAllSwiper } from '@/api/api.js'
	export default {
		components: {
			myTable,
			managerTabbar,
		},
		data(){
			return {
				currentValue: 0,
				// 轮播的图片
				swipers: [],	
				// content 超级管理员  content2 支部管理员
				content:[{
					url: '/static/manager/home/内容发布.svg',
					title: '内容发布'
				},
				{
					url: '/static/manager/home/内容审核.svg',
					title: '内容审核'
				},{
					url: '/static/manager/home/轮播图管理.svg',
					title: '轮播图管理'
				}],		
				party:[{
					url: '/static/manager/home/支部管理.svg',
					title: '支部管理'
				},
				{
					url: '/static/manager/home/党员管理.svg',
					title: '党员管理'
				},{
					url: '/static/manager/home/积极分子培训.svg',
					title: '积极分子培训'
				}],			
				learn:[{
					url: '/static/manager/home/课程发布.svg',
					title: '课程发布'
				},
				{
					url: '/static/manager/home/学习发布.svg',
					title: '章节发布'
				},
				{
					url: '/static/manager/home/课程管理.svg',
					title: '课程管理'
				},
				{
					url: '/static/manager/home/学习管理.svg',
					title: '学习管理'
				}],				
				dotsStyles: {	
					backgroundColor: 'rgba(255, 90, 95,0.3)',
					border: '1px rgba(255, 90, 95,0.3) solid',
					color: '#fff',
					selectedBackgroundColor: 'rgba(255, 90, 95,0.9)',
					selectedBorder: '1px rgba(255, 90, 95,0.9) solid'
				},
				swiperDotIndex: 0,
				current: 0,
				mode: 'dot',
				// 是否自动切换轮播图
				autoplay: true,
				// 切换时间
				interval: 5000,
				// 循环切换
				circular: true,			
				role: '',
			}
		},
		onLoad() {
			
		},
		onShow() {
			queryIDNameMapping().then((res)=>{
				console.log(res)
				this.$store.state.branchIdToName = res;
			})
			getAllSwiper().then((res)=>{
				console.log(res)
				this.swipers = res
			})
			this.role = uni.getStorageSync('role');
			console.log(this.role)	
		},
		methods: {
			// 轮播
			change(e) {
				this.current = e.detail.current
			},
			clickItem(e) {
				this.swiperDotIndex = e
			},
			contentPublish(index){
				console.log(index)
				if (index === 0){
					uni.navigateTo({
						url:`/pages/manager/home/contentPublish`
					})
				} else if (index === 1){
					uni.navigateTo({
						url:`/pages/manager/home/contentReview`
					})
				} else if (index === 2){
					uni.navigateTo({
						url:`/pages/manager/home/picPublish`
					})
				}		
			},
			partyManage(index){
				const now = new Date();
				const year = now.getFullYear();
				const month = now.getMonth() + 1; // 月份是从0开始的，所以需要+1
				const day = now.getDate();
				const hours = now.getHours();
				const minutes = now.getMinutes();
				const seconds = now.getSeconds();	
				console.log(`当前时间：${year}-${month}-${day} ${hours}:${minutes}:${seconds}`);
				if (index === 0 ){
					uni.navigateTo({
						url:`/pages/manager/home/partyManage`
					})
				} else if (index === 1){
					uni.navigateTo({
						url:`/pages/manager/home/memberManage`
					})
				} else if (index === 2){
					uni.navigateTo({
						url:`/pages/manager/home/afpmanage`
					})
				} else if (index === 3){
					uni.showToast({
						title: '暂无更多内容',
						icon: 'error',
						duration: 1000
					})
				}
			},
			learnManage(index){
				if (index === 0){
					uni.navigateTo({
						url:`/pages/manager/home/classPublish`
					})
				}
				else if (index === 1){
					uni.navigateTo({
						url:`/pages/manager/home/learnPublish`
					})
				}else if (index === 2){
					uni.navigateTo({
						url:`/pages/manager/home/classManage`
					})
				} else if (index === 3){
					uni.navigateTo({
						url:`/pages/manager/home/learnManage`
					})
				} else if (index ===4){
					uni.showToast({
						title: '暂无更多内容',
						icon: 'error',
						duration: 1000
					})
				}
			},
		},

	}
</script>

<style lang="scss">
.swiper-box {
	height: 420rpx;
	width: 100%;
}

.swiper-item {
	/* #ifndef APP-NVUE */
	display: flex;
	/* #endif */
	flex-direction: column;
	justify-content: center;
	align-items: center;
	height: 420rpx;
	width: 100%;
	color: #fff;
}	
.vi-item {
	font-size: 28rpx; 
	line-height: 42rpx; 
	text-align: center; 
	margin-top: 14rpx;
	width:168rpx;
}
.content{
	height: 196rpx; 
	width: 100%; 
	display: flex; 
	flex-direction: row; 
	background-color: white;
}
</style>