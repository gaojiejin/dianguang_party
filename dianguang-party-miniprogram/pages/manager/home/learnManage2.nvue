<template>
	<view>
		<view style="height: 350rpx; width: 100%; background-color: white; display: flex; flex-direction: row;">
			<view style="height: 280rpx; margin-top: 49rpx; width: 30%; margin-left: 5%;">
				<l-circularProgress box-height="150" box-width="150"  progressColor="#1684fc" :lineWidth="15" font-size="15" gradualColor="#1684fc" :percent="percent">
			
				</l-circularProgress>
			</view>
			<view style="height: 280rpx; margin-top: 35rpx; width: 50%; margin-left: 5%;">
				<view style="height: 70rpx; width: 100%; line-height: 70rpx; font-size: 35rpx; font-weight: bold; text-align: center;" >学习统计数据</view>
				<view>
					<picker @change="handleChange" :value="index" :range="learnRateStatistics.map(item => item.learn_class.classTitle)" v-model="learn_type" style="width: 100%;">
						<view style="width: 75%; margin-left: 25%; text-align: center; font-size: 28rpx; margin-top: 14rpx; height: 42rpx; line-height: 42rpx; display: flex; flex-direction: row;" >
							<view style="max-width: 80%; overflow-x: auto; white-space: nowrap;">
								{{learnRateStatistics[index].learn_class.classTitle}}
							</view>
							<image src="/static/manager/home/下.svg" style="margin-left: 1%; width: 10%; height: 42rpx;"></image>
						</view>
					</picker>
				</view>
				<view style="width: 75%; margin-top: 14rpx; margin-left: 25%; height: 56rpx; line-height: 56rpx; display: flex; flex-direction: row;" >
					<image src="/static/manager/home/蓝圆点.png" style="height: 28rpx; margin-top: 14rpx;" mode="heightFix"></image>
					<view style="margin-left: 5%; height: 56rpx; line-height: 56rpx;">总人数</view>
					<view style="margin-left: 5%; height: 56rpx; line-height: 56rpx;">
						{{learnRateStatistics[index].num}} 人
					</view>	
				</view>
				<view style="width: 75%; margin-left: 25%; height: 56rpx; line-height: 56rpx; display: flex; flex-direction: row;">
					<image src="/static/manager/home/灰圆点.png" style="height: 28rpx; margin-top: 14rpx;" mode="heightFix"></image>
					<view style="margin-left: 5%; height: 56rpx; line-height: 56rpx;">未完成</view>
					<view style="margin-left: 5%; height: 56rpx; line-height: 56rpx;">
						{{learnRateStatistics[index].num - learnRateStatistics[index].finishNum}} 人
					</view>
				</view>
			</view>
		</view>
		<view style="height: 84rpx; line-height: 84rpx; width: 100%;">
		      <uni-search-bar
		        placeholder="搜索"
		        :modelValue="searchQuery"
				cancelButton='none'
		        @input="onSearchInput"
		      />
		</view>
		<view v-for="(item,index) in learnRateStatistics" :key="index" >
			<view v-if="searchQuery === '' || item.learn_class.classTitle.includes(searchQuery)">
				<view style="height: 168rpx; width: 100%; border-radius: 10px;  background-color: white; margin-top: 28rpx;"  @click="toggleExpand(index)">
					<view style="width: 100%; height: 140rpx; margin-left: 3%; margin-top: 14rpx; display: flex; flex-direction: row;">
						<view style="margin-top: 14rpx;">
							<u-avatar :src="item.learn_class.classPortrait" shape="square" size="112rpx"></u-avatar>	
						</view>	
						<view style="margin-top: 14rpx; margin-left: 5%; width: 65%;">
							<view style="height: 56rpx; line-height: 56rpx; font-size: 35rpx; overflow-x: auto; white-space: nowrap;">{{item.learn_class.classTitle }}</view>
							<view style="height: 56rpx; line-height: 56rpx; font-size: 25.2rpx; color: gray;">{{item.learn_class.department}}</view>		
						</view>
						<image src="/static/manager/home/下.svg" style="height: 28rpx; width: 10%; margin-top: 56rpx;"></image>			
					</view>
				</view>
				<transition name="expand">
					<view v-show="expandedList[index]">
						<view v-for="(item2,index2) in learnRateStatistics[index].branches" :key="index2" @click="ToLearnDetail(index, index2)">
							<view style="width: 90%; margin-left: 5%; height: 140rpx; margin-top: 14rpx; background-color: white; border-radius: 20px;">
								<!-- <view style="width: 90%; height: 84rpx; line-height: 84rpx; margin-left: 5%; border-bottom: 1px solid #e8e8e8; font-size: 30.8rpx; font-weight: bold;">
									{{item2.branch.branchName}}
								</view> -->
								<view style="width: 90%; margin-left: 5%; height: 140rpx; display: flex; flex-direction: row;">
									<view style="width: 25%; height: 126rpx;">
										<view style="height: 84rpx; line-height: 84rpx; color: black; font-size: 42rpx; text-align: center;">
											{{item2.num}}
										</view>
										<view style="height: 42rpx; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
											支部总人数
										</view>
									</view>
									<view style="width: 25%; height: 126rpx;">
										<view style="height: 84rpx; line-height: 84rpx; color: #fccc08; font-size: 42rpx; text-align: center;">
											{{item2.finishNum}}
										</view>
										<view style="height: 42rpx; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
											完成人数
										</view>
									</view>
									<view style="width: 25%; height: 126rpx;">
										<view style="height: 84rpx; line-height: 84rpx; color: #ff2020; font-size: 42rpx; text-align: center;">
											{{item2.num - item2.finishNum}}
										</view>
										<view style="height: 42rpx; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
											未完成人数
										</view>
									</view>
									<view style="width: 25%; height: 126rpx;">
										<view style="height: 84rpx; line-height: 84rpx; color: #c3dba0; font-size: 42rpx; text-align: center;">
											{{Math.round(item2.finishNum*1000/item2.num)/10}}%
										</view>
										<view style="height: 42rpx; line-height: 42rpx;font-size: 25.2rpx; text-align: center;">
											完成率
										</view>
									</view>
								</view>
							</view>	
						</view>
					</view>			
				</transition>	
			</view>
		</view>
		<view style="height: 42rpx;"></view>
	</view>
</template>

<script>
	import { getLearnRateStatisticsByBranchId, exportLearnRateStatistics } from '@/api/api.js' // 假设这里有一个后端导出的API
	
	export default {
	  data() {
	    return {
	      percent: 75,
	      searchQuery: '',
	      index: 0,
		  isOpen: false,
	      expandedList: [],
	      learn_type: '大学习第一期',
	      learnRateStatistics: [],
		  
	    };
	  },
	  onLoad() {
		var data = {
			branch_id: this.$store.state.user.branchId
		}
	    // 获取学习统计数据
	    getLearnRateStatisticsByBranchId(data).then((res) => {
			console.log(res)
			if (res !== null) {
				this.learnRateStatistics = res;
				this.expandedList = this.learnRateStatistics.map(() => false);
				console.log(this.expandedList)
				this.learn_type = this.learnRateStatistics[this.index].learn_class.classTitle;
				this.percent = Math.round(this.learnRateStatistics[this.index].finishNum * 1000 / this.learnRateStatistics[this.index].num) / 10;
			}
	    });
	  },
	  methods: {
	    handleChange(event) {
	      this.index = event.detail.value;
	      this.learn_type = this.learnRateStatistics[this.index].learn_class.classTitle;
	      this.percent = Math.round(this.learnRateStatistics[this.index].finishNum * 1000 / this.learnRateStatistics[this.index].num) / 10;
	    },
	    onSearchInput(value) {
	      this.searchQuery = value;
	    },
	    toggleExpand(index) {
			this.expandedList[index] = !this.expandedList[index];
		    this.isOpen = !this.isOpen;
	    },
	    ToLearnDetail(index, index2) {
	      uni.navigateTo({
	        url: `/pages/manager/home/learnDetail?class_id=${encodeURIComponent(JSON.stringify(this.learnRateStatistics[index].learn_class.classId))}&branch_id=${encodeURIComponent(JSON.stringify(this.learnRateStatistics[index].branches[index2].branch.branchId))}`,
	      });
	    },
	    // 导出学习情况统计
	    exportLearningStatistics() {
	      const data = {
	        class_id: this.learnRateStatistics[this.index].learn_class.classId,
	        branch_id: this.learnRateStatistics[this.index].branchs.map(branch => branch.branch.branchId)
	      };
	
	      // 请求后端导出接口
	      uni.request({
	        url: '/api/exportAllLearnStats', // 替换为实际的后端导出API
	        method: 'POST',
	        data: data,
	        success: (res) => {
	          if (res.statusCode === 200 && res.data.fileUrl) {
	            // 使用uni.downloadFile下载文件
	            uni.downloadFile({
	              url: res.data.fileUrl, // 后端返回的文件下载链接
	              success: (downloadRes) => {
	                if (downloadRes.statusCode === 200) {
	                  uni.showToast({
	                    title: '文件下载成功',
	                    icon: 'success',
	                    duration: 2000
	                  });
	                  // 自动打开下载的文件
	                  uni.openDocument({
	                    filePath: downloadRes.tempFilePath,
	                    success: () => {
	                      console.log('打开文档成功');
	                    }
	                  });
	                } else {
	                  uni.showToast({
	                    title: '文件下载失败',
	                    icon: 'none',
	                    duration: 2000
	                  });
	                }
	              },
	              fail: () => {
	                uni.showToast({
	                  title: '文件下载失败',
	                  icon: 'none',
	                  duration: 2000
	                });
	              }
	            });
	          } else {
	            uni.showToast({
	              title: '导出失败',
	              icon: 'none',
	              duration: 2000
	            });
	          }
	        },
	        fail: () => {
	          uni.showToast({
	            title: '请求失败',
	            icon: 'none',
	            duration: 2000
	          });
	        }
	      });
	    }
	  }
	};

</script>

<style >
.expand-enter-active, .expand-leave-active {
  transition: all 0.5s ease;
}

.expand-enter, .expand-leave-to /* .expand-leave-active in <2.1.8 */ {
  max-height: 0;
  opacity: 0;
}
</style>