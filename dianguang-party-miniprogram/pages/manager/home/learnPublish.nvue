<template>
	<view>
		<view class="title">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">标题</view>
				<input style="width: 100%; height: 84rpx; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入标题" type="text" v-model="title" />	
			</view>		
		</view>
		<view class="classify">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx; display: flex; flex-direction: row;  border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">学习分类</view>
				<view style="width: 55%; text-align: right; height: 84rpx; line-height: 84rpx; margin-right: 2.5%; display: flex; flex-direction: row;">
					<picker @change="classChange" :value="index" :range="class_list" v-model="class_type" style="width: 100%;">
						<view style="text-align: right; margin-right: 2.5%;" >{{class_list[class_index]}}</view>
					</picker>
				</view>
			</view>		
		</view>
		<!-- <view class="source">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx; display: flex; flex-direction: row;  border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">文章来源</view>
				<view style="width: 55%; text-align: right; height: 84rpx; line-height: 84rpx; margin-right: 2.5%; display: flex; flex-direction: row;">
					<picker @change="sourceChange" :value="source_index" :range="source_list" v-model="source_type" style="width: 100%;">
						<view style="text-align: right; margin-right: 2.5%;">{{ source_list[source_index] }}</view>
					</picker>
				</view>
			</view>
		</view> -->

		<!-- 新增 URL 输入框 -->
		 <view v-if="class_type === '链接'" class="url-input">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">链接地址</view>
				<input style="width: 100%; height: 84rpx; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入url" type="text" v-model="url" />	
			</view>	
		</view>
		<view v-if="class_type === '链接'" class="duration-input">
		  <view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
		    <view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
		    <view style="line-height: 84rpx; font-weight: bold;">学习时长（秒）</view>
		    <input style="width: 100%; height: 84rpx; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入学习时长" type="number" v-model="duration" />  
		  </view>  
		</view>

		<view v-if="class_type === '视频'" class="photo">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx;">
				<view style="margin-left: 2.5%; line-height: 84rpx; font-weight: bold;">请上传视频</view>
			</view>
			<view style="width: 90%;margin-left: 5%;">
				 <uni-file-picker
			      v-model="Value"
			      file-mediatype="video"			  
			      limit="1"
			      @progress="onProgress"
			      @success="onSuccess"
			      @fail="onFail"
			      @select="onVideoSelect"
			    ></uni-file-picker>
			</view>
			<view style="height: 42rpx;"></view>
			<!-- 隐藏的视频播放器，仅用于获取时长 -->
			<video id="video" :src="videoUrl" @loadedmetadata="getVideoDuration" style="display:none;"></video>
		</view>
		<view class="classify">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx; display: flex; flex-direction: row;  border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">所属章节</view>
				<view style="width: 55%; text-align: right; height: 84rpx; text-align: right; line-height: 84rpx; margin-right: 2.5%; display: flex; flex-direction: row; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
					<picker @change="courseChange" :value="index" :range="courses.map(item => item.classTitle)" v-model="course_index" style="width: 100%;">
						<view  style="text-align: right; margin-right: 2.5%;" >{{courses[course_index].classTitle}}</view>
					</picker>
				</view>
			</view>		
		</view>
		
		<view class="photo">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">上传章节头像</view>
			</view>
			<view style="margin-left: 5%;">
				<uni-file-picker
				v-model="Value" 
				fileMediatype="image"  
				limit="1" 
				@progress="onProgress"
				@success="onSuccess"
				@fail="onFail"
				@select="onImageSelect"
				></uni-file-picker>
			</view>
			<view style="height: 42rpx;"></view>
		</view>
		
		<picker-color :isShow="showfontColor" :bottom="0"  @callback='getColor' />
		
		<picker-color :isShow="showfontBackgroundColor" :bottom="0"  @callback='getBackgroundColor' />
	
	<view v-if="class_type !== '链接'" class="container">
			<view class="page-body">
				<view class='wrapper'>
					<view class='toolbar' @tap="format" style="background-color:white; display: flex; flex-direction: row; flex-wrap: wrap;">
						<view :class="formats.bold ? 'ql-active' : ''" class="iconfont icon-zitijiacu" data-name="bold">
						</view>
						<view :class="formats.italic ? 'ql-active' : ''" class="iconfont icon-zitixieti" data-name="italic">
						</view>
						<view :class="formats.underline ? 'ql-active' : ''" class="iconfont icon-zitixiahuaxian"
							data-name="underline"></view>
						<view :class="formats.strike ? 'ql-active' : ''" class="iconfont icon-zitishanchuxian"
							data-name="strike"></view>
						<!-- #ifndef MP-BAIDU -->
						<view :class="formats.align === 'left' ? 'ql-active' : ''" class="iconfont icon-zuoduiqi"
							data-name="align" data-value="left"></view>
						<!-- #endif -->
						<view :class="formats.align === 'center' ? 'ql-active' : ''" class="iconfont icon-juzhongduiqi"
							data-name="align" data-value="center"></view>
						<view :class="formats.align === 'right' ? 'ql-active' : ''" class="iconfont icon-youduiqi"
							data-name="align" data-value="right"></view>
						<view :class="formats.align === 'justify' ? 'ql-active' : ''" class="iconfont icon-zuoyouduiqi"
							data-name="align" data-value="justify"></view>
						<!-- #ifndef MP-BAIDU -->
						<view :class="formats.lineHeight ? 'ql-active' : ''" class="iconfont icon-line-height"
							data-name="lineHeight" data-value="2"></view>
						<view :class="formats.letterSpacing ? 'ql-active' : ''" class="iconfont icon-Character-Spacing"
							data-name="letterSpacing" data-value="2em"></view>
						<view :class="formats.marginTop ? 'ql-active' : ''" class="iconfont icon-722bianjiqi_duanqianju"
							data-name="marginTop" data-value="20px"></view>
						<view :class="formats.marginBottom ? 'ql-active' : ''" class="iconfont icon-723bianjiqi_duanhouju"
							data-name="marginBottom" data-value="20px"></view>
						<!-- #endif -->
	 
						<view class="iconfont icon-clearedformat" @tap="removeFormat"></view>
	 
						<!-- #ifndef MP-BAIDU -->
						<view :class="formats.fontFamily ? 'ql-active' : ''" class="iconfont icon-font"
							data-name="fontFamily" data-value="Pacifico"></view>
							
						<picker @change="fontChange" :value="index" :range="font">
							<view :class="formats.fontSize === fontSize ? 'ql-active' : ''" class="iconfont icon-fontsize"></view>
						</picker>
						

						<!-- #endif -->
						<view :class="formats.color === fontColor ? fontColor : ''" class="iconfont icon-text_color"
							 @tap="showColor"></view>
						<view :class="formats.backgroundColor === backgroundColor ? backgroundColor : ''"
							class="iconfont icon-fontbgcolor" @tap="showBackgroundColor"></view>
						<view class="iconfont icon-date" @tap="insertDate"></view>
						<view class="iconfont icon--checklist" data-name="list" data-value="check"></view>
						<view :class="formats.list === 'ordered' ? 'ql-active' : ''" class="iconfont icon-youxupailie"
							data-name="list" data-value="ordered"></view>
						<view :class="formats.list === 'bullet' ? 'ql-active' : ''" class="iconfont icon-wuxupailie"
							data-name="list" data-value="bullet"></view>
	 
						<view class="iconfont icon-undo" @tap="undo"></view>
						<view class="iconfont icon-redo" @tap="redo"></view>
	 
						<view class="iconfont icon-outdent" data-name="indent" data-value="-1"></view>
						<view class="iconfont icon-indent" data-name="indent" data-value="+1"></view>
						<view class="iconfont icon-fengexian" @tap="insertDivider"></view>
						<view class="iconfont icon-charutupian" @tap="insertImage"></view>

						<view :class="formats.header === 1 ? 'ql-active' : ''" class="iconfont icon-format-header-1"
							data-name="header" :data-value="1"></view>
						<view :class="formats.header === 2 ? 'ql-active' : ''" class="iconfont icon-format-header-2"
							data-name="header" :data-value="2"></view>
						<view :class="formats.header === 3 ? 'ql-active' : ''" class="iconfont icon-format-header-3"
							data-name="header" :data-value="3"></view>
						<view :class="formats.header === 4 ? 'ql-active' : ''" class="iconfont icon-format-header-4"
							data-name="header" :data-value="4"></view>
						<view :class="formats.header === 5 ? 'ql-active' : ''" class="iconfont icon-format-header-5"
							data-name="header" :data-value="5"></view>
						<view :class="formats.script === 'sub' ? 'ql-active' : ''" class="iconfont icon-zitixiabiao"
							data-name="script" data-value="sub"></view>
						<view :class="formats.script === 'super' ? 'ql-active' : ''" class="iconfont icon-zitishangbiao"
							data-name="script" data-value="super"></view>
	 
						<view class="iconfont icon-shanchu" @tap="clear"></view>
	 
						<view :class="formats.direction === 'rtl' ? 'ql-active' : ''" class="iconfont icon-direction-rtl"
							data-name="direction" data-value="rtl"></view>
					</view>
	 
					<view class="editor-wrapper">
						<editor id="editor" class="ql-container" placeholder="请输入..." show-img-size show-img-toolbar
							show-img-resize @statuschange="onStatusChange" :read-only="readOnly" @ready="onEditorReady" @blur="blur" @input="onEditorInput">
						</editor>
					</view>		
				</view>
			</view>
		</view>	

		<view style="height: 112rpx;"></view>
		<button class="btn" @click="submit()">发 布</button>
	</view>
</template>

<script>
	import { getClasses, addChapter, checkChapterName } from '@/api/api.js'
	import { getBase_url } from '@/api/index.js'
	import pickerColor from "@/components/helang-pickerColor/helang-pickerColor.vue"
	export default {
		components: {
		    "picker-color":pickerColor,
		},
		data (){
			return{
				// source_index: 0,
				// source_type: '本地编辑',  // 默认选择
				// source_list: ['本地编辑', '电光官网', '互联网'],
				class_index: 0,
				class_type: '图文',
				class_list: ['图文', '视频', '链接'],
				course_index: 0,
				course_tpye: '',
				courses: [],
				
				title: '',

				Value: [],			
				imageUrl: '',
				
				videoUrl: '',
				
				readOnly: false,
				formats: {},
				info: '',
				
				images: [],
				duration: '',
				
				fontSize: '',
				font: ['6px', '8px', '10px', '12px', '14px', '16px', '18px', '20px', '22px', '24px', '26px', '28px', '30px', '32px'],
				fontColor: '',
				backgroundColor: '',
				
				
				showFontSizePicker: false,
				showfontColor: false,
				showfontBackgroundColor: false,
				bottomPickerColor:0
				
			}
		},
		onLoad() {
			getClasses().then((res)=>{
				console.log(res)
				this.courses = res
				this.course_tpye = res[this.course_index].classTitle
				console.log(this.course_tpye)
			})
		},
		methods: {
			blur(e){
				// this.info=e.detail.html
				// console.log(this.info,e,'失去焦点')			
			},
			readOnlyChange() {
				this.readOnly = !this.readOnly
			},
			sourceChange(event) {
							this.source_index = event.detail.value;
							this.source_type = this.source_list[this.source_index];
						},
			onEditorReady() {
				// #ifdef MP-BAIDU
				this.editorCtx = requireDynamicLib('editorLib').createEditorContext('editor');
				// #endif
			 
				// #ifdef APP-PLUS || MP-WEIXIN || H5
				uni.createSelectorQuery().select('#editor').context((res) => {
					this.editorCtx = res.context
				}).exec()
				// #endif
			},
			onEditorInput(e){
				this.info=e.detail.html
			},
			undo() {
				this.editorCtx.undo()
			},
			redo() {
				this.editorCtx.redo()
			},
			format(e) {
				let {
					name,
					value
				} = e.target.dataset
				if (!name) return
				this.editorCtx.format(name, value)
			},
			onStatusChange(e) {
				const formats = e.detail
				this.formats = formats
			},
			insertDivider() {
				this.editorCtx.insertDivider({
					success: function() {
						console.log('insert divider success')
					}
				})
			},
			clear() {
				uni.showModal({
					title: '清空编辑器',
					content: '确定清空编辑器全部内容？',
					success: (res) => {
						if (res.confirm) {
							this.editorCtx.clear({
								success: function(res) {
									console.log("clear success")
								}
							})
						}
					}
				});
			},
			removeFormat() {
				this.editorCtx.removeFormat()
			},
			insertDate() {
				const date = new Date()
				const formatDate = `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`
				this.editorCtx.insertText({
					text: formatDate
				})
			},
			insertImage() {
				uni.chooseImage({
					count: 1,
					success: (res) => {
						this.editorCtx.insertImage({
							src: res.tempFilePaths[0],
							alt: '图像',
							success: function() {
								console.log('insert image success')
							}
						})
					}
				})
			},
			classChange: function(event) {
				this.class_index = event.detail.value
				this.class_type = this.class_list[this.class_index]
			},
			courseChange: function(event) {
				this.course_index = event.detail.value
				this.course_type = this.courses[this.course_index].classTitle
			},
			onProgress(event){
				console.log('process')
			},
			onSuccess(res){
				console.log('success')
			},
			onFail(err){
				console.log('fail')
			},
			onImageSelect(res){
				this.imageUrl = res.tempFilePaths[0]	 
			},
			onVideoSelect(res){
				console.log(res.tempFilePaths[0])
				this.videoUrl = res.tempFilePaths[0]
			},
			showColor(){
				this.showfontColor = true
			},
			showBackgroundColor(){
				this.showfontBackgroundColor = true
			},
			fontChange: function(event) {
			    this.fontSize = this.font[event.detail.value];
			    this.$nextTick(() => {
			        this.editorCtx.format('fontSize', this.fontSize);
			    });
			    console.log('字体大小设置为:', this.fontSize);
			},
			getColor(res){
				this.fontColor = res || null
				this.$nextTick(() => {
					this.editorCtx.format('color', this.fontColor);
				});
				console.log(this.fontColor)
				this.showfontColor = false
			},
			getBackgroundColor(res){
				this.backgroundColor = res || null
				this.$nextTick(() => {
					this.editorCtx.format('backgroundColor', this.backgroundColor);
				});
				this.showfontBackgroundColor = false				
			},
			// 获取视频时长
			getVideoDuration(e) {
			    this.duration = e.target.duration;  // 通过loadedmetadata事件获取视频时长
			    console.log("视频时长: ", this.duration);
			},
submit(){
    if (this.title === '') {
        uni.showToast({
            title: '标题不能为空',
            icon: 'error',
            duration: 1000
        })
    } else if (this.class_type === '视频' && this.videoUrl === '') {
        uni.showToast({
            title: '请上传视频',
            icon: 'error',
            duration: 1000
        })
    } else if (this.imageUrl === '') {
        uni.showToast({
            title: '章节头像不能为空',
            icon: 'error',
            duration: 1000
        })
    } else if (this.class_type === '链接' && this.duration === '') {  // 这里增加了对链接类型时长的判断
        uni.showToast({
            title: '学习时长不能为空',
            icon: 'error',
            duration: 1000
        })
    } else {
        var check = {
            class_id: this.courses[this.course_index].classId,
            title: this.title,
        }
        checkChapterName(check).then((res) => {
            if (res === false) {
                uni.showToast({
                    title: "章节名已存在",
                    icon: 'none'
                })
                return;
            } else {
                console.log(this.info)
                const imageUrls = this.extractImageUrls(this.info);
                const newUrls = [];
                if (imageUrls.length > 0) {
                    // 创建一个数组来存储每个上传操作的 Promise
                    const uploadPromises = imageUrls.map((imageUrl, index) => {
                        return new Promise((resolve, reject) => {
                            uni.uploadFile({
                                url: getBase_url() + 'class/upload',  // 替换成你的图片上传接口地址
                                filePath: imageUrl,
                                name: 'url',
                                success: (res) => {
                                    this.images.push(res.data);
                                    this.info = this.info.replace(new RegExp(imageUrl, 'g'), res.data);
                                    console.log(this.images)
                                    resolve(res.data);
                                },
                                fail: (error) => {
                                    console.error('上传失败:', error);
                                    reject(error);  // 上传失败时，调用 reject
                                }
                            });
                        });
                    });
                    // 使用 Promise.all 来等待所有上传操作完成
                    Promise.all(uploadPromises).then((results) => {
                        uni.uploadFile({
                            url: getBase_url() + 'class/upload',  // 替换成你的图片上传接口地址
                            filePath: this.imageUrl,
                            name: 'url',
                            success: (res) => {
                                this.imageUrl = res.data
                                let duration = this.class_type === '链接' ? this.duration : Math.floor(this.duration);  // 只修改这里，保持其他逻辑不变

                                var data = {
                                    founder: this.$store.state.user.name,
                                    founder_id: this.$store.state.user.id,
                                    class_id: this.courses[this.course_index].classId,
                                    title: this.title,
                                    type: this.class_index === 0 ? 1 : (this.class_index === 1 ? 2 : 3),
                                    content: this.class_type === '链接' ? this.url : this.info,
                                    chapter_portrait: this.imageUrl,
                                    chapterImage: this.images,
                                    chapterVideo: this.videoUrl,
                                    duration: duration,  // 使用正确的duration值
                                }

                                console.log(data)
                                addChapter(data).then((res) => {
                                    if (res === '成功创建章节') {
                                        uni.showToast({
                                            title: "章节上传成功",
                                            icon: 'none'
                                        })
                                        setTimeout(() => {
                                            uni.switchTab({
                                                url:`/pages/manager/home/home`
                                            })
                                        }, 1000);
                                    } else {
                                        uni.showToast({
                                            title: res,
                                            icon: 'none'
                                        })
                                    }
                                })
                            },
                            fail: (error) => {
                                console.error('上传失败:', error);
                            }
                        })
                    })
                    .catch((error) => {
                        console.error('有文件上传失败:', error);
                    });
                } else {
                    // 无图片上传的情况
                    uni.uploadFile({
                        url: getBase_url() + 'class/upload',  // 替换成你的图片上传接口地址
                        filePath: this.imageUrl,
                        name: 'url',
                        success: (res) => {
                            this.imageUrl = res.data
                            let duration = this.class_type === '链接' ? this.duration : Math.floor(this.duration);  // 只修改这里，保持其他逻辑不变
                            
                            var data = {
                                founder: this.$store.state.user.name,
                                founder_id: this.$store.state.user.id,
                                class_id: this.courses[this.course_index].classId,
                                title: this.title,
                                type: this.class_index === 0 ? 1 : (this.class_index === 1 ? 2 : 3),
                                content: this.class_type === '链接' ? this.url : this.info,
                                chapter_portrait: this.imageUrl,
                                chapterImage: this.images,
                                chapterVideo: this.videoUrl,
                                duration: duration,  // 使用正确的duration值
                            };

                            addChapter(data).then((res) => {
                                if (res === '成功创建章节') {
                                    uni.showToast({
                                        title: "章节上传成功",
                                        icon: 'none'
                                    })
                                    setTimeout(() => {
                                        uni.switchTab({
                                            url:`/pages/manager/home/home`
                                        })
                                    }, 1000);
                                } else {
                                    uni.showToast({
                                        title: res,
                                        icon: 'none'
                                    })
                                }
                            })
                        },
                        fail: (error) => {
                            console.error('上传失败:', error);
                        }
                    });
                }
            }
        });
    }
},
			extractImageUrls(html) {
			    const imgTagRegex = /<img[^>]+src="([^">]+)"/g;
			    let match;
			    const urls = [];
			    while ((match = imgTagRegex.exec(html)) !== null) {
					urls.push(match[1]);
			    }
				console.log(urls)
			    return urls;
			},
		}
	}
</script>

