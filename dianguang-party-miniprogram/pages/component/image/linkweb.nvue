<template><view><view v-if="error" class="u-state"><text>{{error}}</text><button class="m-small-button" @click="load">重试</button></view><web-view v-if="url" :src="url" @error="externalError"/><view v-if="pending" class="u-link-sync" @click="mark">记录待同步，点击重试</view></view></template>
<script>
import {chapterData,reportLearning,touchChapter} from '@/utils/learning';
export default {data:()=>({options:{},chapter:{},user:{},url:'',error:'',completed:false,pending:false,sending:false,remaining:180}),onLoad(options){this.options=options;this.load()},onShow(){if(this.url)this.start()},onHide(){clearInterval(this.timer)},onUnload(){clearInterval(this.timer)},methods:{async load(){this.error='';try{const data=await chapterData(this.options);this.chapter=data.chapter;this.user=data.user;this.completed=data.completed;if(!/^https?:\/\//i.test(this.chapter.content||''))throw new Error('学习链接无效');this.url=this.chapter.content;touchChapter(this.chapter);this.start()}catch(e){this.error=e.message||'链接加载失败'}},externalError(){this.error='链接无法打开，请检查网络和微信业务域名配置';this.url='';clearInterval(this.timer)},start(){clearInterval(this.timer);if(this.completed)return;this.timer=setInterval(()=>{if(this.remaining>0)this.remaining--;else{clearInterval(this.timer);this.mark()}},1000)},async mark(){if(this.completed||this.sending)return;this.sending=true;try{await reportLearning({class_id:this.chapter.classId,chapter_id:this.chapter.chapterId,user_id:this.user.id,if_learned:1,learn_duration:300});this.completed=true;this.pending=false;uni.showToast({title:'学习完成',icon:'success'})}catch(e){this.pending=true}finally{this.sending=false}}}}
</script>