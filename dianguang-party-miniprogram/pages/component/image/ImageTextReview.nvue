<template>
	<view style="margin-left: 2.5%; width: 95%;">
        <view v-if="article.type === '链接展示'">
            <web-view :fullscreen="false" :src="content" ></web-view>
        </view>
        <view>
            <h1 style="font-weight: bold; font-size: 30.8rpx; line-height: 42rpx; margin-top: 14rpx;">{{ article.title }}</h1>
            <view style="display: flex; flex-direction: row;">
                <view style="margin-top: 14rpx; height: 3vh; line-height: 42rpx; font-size: 25.2rpx;color: #59b4cd">
                    {{ article.type }}
                </view>
                <view style="height: 3vh; line-height: 42rpx; margin-top: 14rpx; margin-left: 3%; font-size: 25.2rpx;color: gray;">
                    {{  time }}
                </view>
            </view>
            <view style="margin-top: 28rpx;"  v-if="article.type === '微课堂展示'">
                <view class="page-body">
                    <view class="page-section">
                        <video id="myVideo" :src=article.videoPath
                               style="width: 100%;"
                               @play="videoPlay"
                               @pause="videoPause"
                               @error="videoErrorCallback"
                               @ended="videoEnded"
                               :danmu-list="danmuList"
                               show-mute-btn
                               enable-play-gesture
                               controls
                        ></video>
                    </view>
                </view>
            </view>
            <view class="content" v-html="content" style="width: 100%; margin-top: 28rpx;"></view>


            <view v-if="role === '超级管理员'" class="bottom">
                <view class="pass" @click="dialogToggle()">通 过</view>
                <view class="reject" @click="inputDialogToggle()">驳 回</view>
            </view>
            <view v-else class="width: 100%; height: 10vh; margin-top: 28rpx;background-color: white;">
                <view class="wait">等待审核</view>
                <view style="height: 3vh;"></view>
            </view>

            <view>
                <uni-popup ref="alertDialog" type="dialog">
                    <uni-popup-dialog :type="msgType" cancelText="取消" confirmText="审核通过" content="请确认是否审核通过!" @confirm="Pass()"
                    ></uni-popup-dialog>
                </uni-popup>
            </view>

            <view>
                <uni-popup ref="inputDialog" type="dialog">
                    <uni-popup-dialog ref="inputClose"  mode="input" v-model="dialogContent"
                                      placeholder="请输入驳回内容" @confirm="Reject()"></uni-popup-dialog>
                </uni-popup>
            </view>
        </view>
	</view>
</template>

<script>
	import {uploadReviewState} from '@/api/api.js'
	import { formatDate } from '@/utils/formatDate.js'
	export default {
		data(){
			return{
				dialogContent: '',
				article: '',
				role: '',
				content: '',
				time: '',
			}
		},
		onLoad(options) {
			this.article = JSON.parse(decodeURIComponent(options.article));
			this.content = this.article.content.replace(/\<img/gi, '<img style="max-width:100%;height:auto" ')
			this.time = formatDate(this.article.uploadTime)
			this.role = this.$store.state.user.role
		},
		onReady: function (res) {
			this.videoContext = uni.createVideoContext('myVideo')
		},
		methods: {
			Pass(){
				var data = {
					article_id: this.article.articleId,
					reviewer: this.$store.state.user.name,
					reviewer_id: this.$store.state.user.id,
					review_result: 1,
				}
				console.log(data)
				uploadReviewState(data).then((res)=>{
					console.log(res)
					uni.showToast({
						title: "审核文件成功",
						icon: 'none'
					})	
					setTimeout(() => {
						uni.switchTab({
							url:`/pages/manager/home/home`
						})
					}, 1000);
				})
			},
			dialogToggle() {
				this.$refs.alertDialog.open()
			},
			inputDialogToggle() {
				this.dialogContent = ''
				this.$refs.inputDialog.open()
			},
			Reject(){
				if (this.dialogContent === ''){
					uni.showToast({
						title: '原因不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else{
					var data = {
						article_id: this.article.articleId,
						reviewer: this.$store.state.user.name,
						reviewer_id: this.$store.state.user.id,
						review_result: 2,
						advice: this.dialogContent
					}
					console.log(data)
					uploadReviewState(data).then((res)=>{
						console.log(res)
						uni.showToast({
							title: "驳回文件成功",
							icon: 'none'
						})	
						setTimeout(() => {
							uni.switchTab({
								url:`/pages/manager/home/home`
							})
						}, 1000);
					})
				}
			},
			videoErrorCallback: function (e) {
				console.log('视频错误信息:')
				console.log(e.target.errMsg)
			},
			videoPlay(){
				console.log('视频播放');
				
			},
			videoPause() {
				console.log('视频暂停');
			},
			videoEnded() {
				console.log('视频结束');
			},
		}
	}
</script>

<style>
.bottom{
	width: 100%;
	height: 7vh; 
	margin-top: 98rpx;
	position: fixed; 
	bottom: 0;
	background-color: white;
	display: flex;
	flex-direction: row;
}	
.pass{
	width: 30%; 
	margin-left: 10%; 
	text-align: center; 
	color: white;
	background-color: #ff4a32; 
	margin-top: 21rpx;
	line-height: 56rpx; 
	height: 4vh;
	border: white solid 1px;
	border-radius: 5px;
}
.reject{
	width: 30%; 
	margin-left: 15%; 
	text-align: center; 
	color: #ff4a32; 
	background-color: white; 
	margin-top: 21rpx;
	line-height: 56rpx; 
	height: 4vh;
	border: #ff4a32 solid 1px;
	border-radius: 5px
}
.wait{
	width: 20%; 
	margin-left: 75%; 
	text-align: center; 
	color: white;
	background-color: #ff4a32; 
	margin-top: 21rpx;
	line-height: 56rpx; 
	height: 4vh;
	border: white solid 1px;
	border-radius: 5px;
}

</style>