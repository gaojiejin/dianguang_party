<template>
	<view ref="content" id="content" style="width: 100%;">
		<h1 style="width: 95%; margin-left: 2.5%; font-weight: bold; font-size: 30.8rpx; line-height: 42rpx; margin-top: 14rpx;">{{ chapter.title }}</h1>
		<view style="width: 100%; margin-top: 14rpx; display: flex; flex-direction: row;">
			<view style="width: 70%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="height: 42rpx; line-height: 42rpx; font-size: 25.2rpx;color: #59b4cd">
					图文学习
				</view>
				<view style="height: 42rpx; line-height: 42rpx; margin-left: 3%; font-size: 25.2rpx;color: gray;">
					{{  time }}
				</view>
			</view>
			
			<view v-if="!ifLearned" style="width: 20%; left: 7.5%; height: 42rpx; line-height: 42rpx; font-size: 25.2rpx; text-align: center; background-color: #ff4a32;">
				未完成
			</view>
			<view v-else style="width: 20%; left: 7.5%; height: 42rpx; line-height: 42rpx; font-size: 25.2rpx; text-align: center; background-color: #81b337;">
				已完成
			</view>
		</view>

		<view v-html="content" style="width: 95%; margin-left: 2.5%; margin-top: 14rpx;"></view>
	</view>
</template>

<script>
	import { updateLearnRate,addLearnDuration } from '@/api/api.js'
	import { formatDate } from '@/utils/formatDate.js'
	export default {
		data(){
			return{
				ifLearned: true,
				viewHeight: 0,
				pageHeight: 0,
				class_id: '',
				chapter: '',
				content: '',
				time: '',
			}
		},
		onLoad(options) {
			this.class_id = JSON.parse(decodeURIComponent(options.class_id));	
			this.chapter = JSON.parse(decodeURIComponent(options.chapter));	
			this.content = this.chapter.content.replace(/\<img/gi, '<img style="max-width:100%;height:auto" ')
			this.ifLearned = JSON.parse(decodeURIComponent(options.ifLearned));	
			this.time = formatDate(this.chapter.uploadTime)
			console.log(this.chapter)
		},
		mounted(){
		    this.getHeights();
		},
		onReachBottom() {
			if (!this.ifLearned){
				this.ifLearned = true
				var data = {
					class_id: this.class_id,
					chapter_id: this.chapter.chapterId,
					user_id: this.$store.state.user.id,
					if_learned: 1,
					learn_duration: 300,
				}
				addLearnDuration(data).then((res)=>{
					uni.showToast({
						title: '图文学习完成',
						duration: 1000
					});
				})
			}
			console.log('onReachBottom')
		},
		methods: {
			getHeights() {
				if (!this.ifLearned){
					// 获取页面高度
					uni.getSystemInfo({
						success: (res) => {
						  this.pageHeight = res.windowHeight;
						  console.log('Page height:', this.pageHeight);
						},
					})
					// 获取 view 的高度
					this.$nextTick(() => {
						console.log(11);
						const query = uni.createSelectorQuery().in(this);
						query.select('#content').boundingClientRect((data) => {
							if (data){
								this.viewHeight = data.height;
								console.log('View height:', this.viewHeight);
								// 比较高度
								if (this.viewHeight > this.pageHeight) {
									console.log('View height is greater than page height');
								} else {
									setTimeout(() => {
										this.ifLearned = true
										console.log(this.chapter)
										var data_ = {
											class_id: this.class_id,
											chapter_id: this.chapter.chapterId,
											user_id: this.$store.state.user.id,
											if_learned: 1,
											learn_duration: 300,
											
										}
										addLearnDuration(data_).then((res)=>{
											console.log(res)
											uni.showToast({
												title: '图文学习完成',
												duration: 1000
											});
										})
									}, 1000); 							
								}
							}	
						}).exec();
					});
				}
			}
		}
	}
</script>

