<template><view class="m-page u-reader"><view v-if="error" class="u-state"><text>{{error}}</text><button class="m-small-button" @click="load">重试</button></view><template v-else-if="chapter.chapterId"><view class="u-page-title">{{chapter.title}}</view><view class="u-reader-tools"><text>{{completed?'已完成':'未完成'}}</text><view><text v-for="(label,index) in sizes" :key="index" :class="font===index?'u-font-active':''" @click="setFont(index)">{{label}}</text></view></view><view id="reading-body" :style="{fontSize:fontPixels+'px',lineHeight:1.9}"><rich-text :nodes="html"/></view><view v-if="pending" class="u-state"><text>学习记录待同步</text><button class="m-small-button" @click="complete">重试同步</button></view><text class="u-reader-end">{{completed?'本节学习已完成':'阅读到底后记录学习完成'}}</text></template><view v-else class="m-empty">加载中…</view></view></template>
<script>
import {chapterData,htmlForPhone,reportLearning,touchChapter} from '@/utils/learning';import {readLocal,saveLocal} from '@/utils/session';
export default {data:()=>({chapter:{},user:{},completed:false,html:'',font:1,sizes:['小','标准','大'],pending:false,sending:false,error:'',options:{},scroll:0,shortPage:false}),computed:{fontPixels(){return [15,17,20][this.font]}},onLoad(options){this.options=options;this.load()},onShow(){if(this.shortPage&&!this.completed)this.schedule()},onHide(){this.stop();this.savePosition()},onUnload(){this.stop();this.savePosition()},onPageScroll(e){this.scroll=e.scrollTop;this.savePosition()},onReachBottom(){this.complete()},methods:{async load(){this.error='';try{const data=await chapterData(this.options);Object.assign(this,{chapter:data.chapter,user:data.user,completed:data.completed});this.font=readLocal('reader-font',1);this.html=htmlForPhone(this.chapter.content);touchChapter(this.chapter);this.$nextTick(()=>{const position=readLocal('scroll:'+this.chapter.chapterId,0);if(position)uni.pageScrollTo({scrollTop:position,duration:0});this.measureTimer=setTimeout(()=>this.measure(),500)})}catch(e){this.error=e.message||'章节加载失败'}},setFont(index){this.font=index;saveLocal('reader-font',index);this.stop();this.$nextTick(()=>this.measure())},measure(){if(this.completed)return;uni.createSelectorQuery().in(this).select('#reading-body').boundingClientRect(rect=>{if(rect){const height=uni.getSystemInfoSync().windowHeight;this.shortPage=rect.bottom<=height;if(this.shortPage)this.schedule()}}).exec()},schedule(){this.stop();this.timer=setTimeout(()=>this.complete(),1000)},stop(){clearTimeout(this.timer);clearTimeout(this.measureTimer)},savePosition(){if(this.chapter.chapterId)saveLocal('scroll:'+this.chapter.chapterId,this.scroll)},async complete(){if(!this.chapter.chapterId||this.completed||this.sending)return;this.sending=true;try{await reportLearning({class_id:this.chapter.classId,chapter_id:this.chapter.chapterId,user_id:this.user.id,if_learned:1,learn_duration:300});this.completed=true;this.pending=false;uni.showToast({title:'学习完成',icon:'success'})}catch(e){this.pending=true}finally{this.sending=false}}}}
</script>