<template>
	<view style="margin-left: 2.5%; width: 95%;">
        <view v-if="article.type === '链接展示'">
            <web-view src="https://www.dgdy123.cn/link/s/Nu2djLwfCmuzN208d0bwtA" ></web-view>
        </view>
        <view v-else>
            <h1 style="font-weight: bold; font-size: 30.8rpx; line-height: 42rpx; margin-top: 14rpx;">{{ article.title }}</h1>
            <view style="display: flex; flex-direction: row;">
                <view style="margin-top: 14rpx; height: 42rpx; line-height: 42rpx; font-size: 25.2rpx;color: #59b4cd">
                    {{ article.type }}
                </view>
                <view style="height: 42rpx; line-height: 42rpx; margin-top: 14rpx; margin-left: 3%; font-size: 25.2rpx;color: gray;">
                    {{  time }}
                </view>
            </view>
            <view style="margin-top: 28rpx;"  v-if="article.type === '微课堂展示'">
                <view class="page-body">
                    <view class="page-section">
                        <video id="myVideo" :src=article.videoPath
                               style="width: 100%;"
                               @play="videoPlay"
                               @pause="videoPause"
                               @error="videoErrorCallback"
                               @ended="videoEnded"
                               :danmu-list="danmuList"
                               show-mute-btn
                               enable-play-gesture
                               controls
                        ></video>
                    </view>
                </view>
            </view>
            <view class="content" v-html="content" style="margin-top: 28rpx;"></view>
            <view style="height: 28rpx; margin-top: 14rpx; font-size: 25.2rpx;color: gray;">审核人： {{article.reviewer}}</view>
            <view style="height: 42rpx;"></view>
            <view v-if="role === '超级管理员'" class="bottom">
                <view class="edit" @click="editArticle()">编辑属性</view><view class="delet" @click="deletarticle()">删除文章</view>
            </view>
        </view>
	</view>
</template>

<script>
	import { getBase_url } from '@/api/index.js';
	import { formatDate } from '@/utils/formatDate.js'
	export default {		
		data(){
			return{
				article: '',
				role: '',
				content: '',
				time: '',
			}
		},
		onLoad(options) {
			this.article = JSON.parse(decodeURIComponent(options.article));
			this.content = this.article.content.replace(/\<img/gi, '<img style="max-width:100%;height:auto" ')
			this.time = formatDate(this.article.uploadTime)
			this.role = this.$store.state.user.role;
			console.log(this.article);
		},
		onReady: function (res) {
			this.videoContext = uni.createVideoContext('myVideo')
		},
		methods: {
		    deletarticle() {
		        // 弹出确认框，防止误删
		        uni.showModal({
		            title: '确认删除',
		            content: '你确定要删除这篇文章吗？',
		            success: (res) => {
		                if (res.confirm) {
		                    // 用户点击了确认按钮，继续删除操作
		                    uni.request({
		                        url: getBase_url()+'article/deleteArticle', // 替换为你的实际接口地址
		                        method: 'POST',
		                        header: {
		                            'Content-Type': 'application/x-www-form-urlencoded',  // 使用表单编码
		                            'Authorization': `Bearer ${this.$store.state.user.token}`  // 假设你使用了token验证
		                        },
		                        data: {
		                            article_id: this.article.articleId
		                        },
		                        success: (response) => {
		                            if (response.statusCode === 200) {
		                                // 删除成功，提示用户
		                                uni.showToast({
		                                    title: '文章删除成功',
		                                    icon: 'success',
		                                    duration: 2000
		                                });
		                                // 返回到上一页或者刷新当前页面列表
		                                setTimeout(() => {
		                                    uni.navigateBack();
											uni.navigateBack();
		                                }, 2000);
		                            } else {
		                                // 删除失败，提示用户
		                                uni.showToast({
		                                    title: '删除失败，请重试',
		                                    icon: 'none',
		                                    duration: 2000
		                                });
		                            }
		                        },
		                        fail: (error) => {
		                            // 请求失败，提示用户
		                            uni.showToast({
		                                title: '请求失败，请检查网络',
		                                icon: 'none',
		                                duration: 2000
		                            });
		                        }
		                    });
		                }
		            }
		        });
		    },
		    editArticle() {
		        // 将文章数据编码后作为参数传递到编辑页面
		        const encodedArticle = encodeURIComponent(JSON.stringify(this.article));
		        uni.navigateTo({
		            url: `/pages/component/content/editContentPublish?article=${encodedArticle}`
		        });
		        console.log('编辑文章');
		    },
			videoErrorCallback: function (e) {
				console.log('视频错误信息:')
				console.log(e.target.errMsg)
			},
			videoPlay(){
				console.log('视频播放');
				
			},
			videoPause() {
				console.log('视频暂停');
			},
			videoEnded() {
				console.log('视频结束');
			},
		}

	}
</script>

<style>
	.bottom {
	width: 100%;
	height: 98rpx; 
	margin-top: 98rpx;
	position: fixed; 
	bottom: 0;
	background-color: white;
	display: flex;
	flex-direction: row;
	}	
	.delet {
	width: 30%; 
	margin-left: 10%; 
	text-align: center; 
	color: white;
	background-color: #ff4a32; 
	margin-top: 21rpx;
	line-height: 56rpx; 
	height: 56rpx;
	border: white solid 1px;
	border-radius: 5px;
	}	.edit {
		width: 30%;
		margin-left: 15%; 
		text-align: center; 
		color: #ff4a32; 
		background-color: white; 
		margin-top: 21rpx;
		line-height: 56rpx; 
		height: 56rpx;
		border: #ff4a32 solid 1px;
		border-radius: 5px
	}
</style>
