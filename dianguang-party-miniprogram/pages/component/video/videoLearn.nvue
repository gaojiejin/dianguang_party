<template><view class="m-page u-reader"><view v-if="error" class="u-state"><text>{{error}}</text><button class="m-small-button" @click="load">重新加载</button></view><template v-if="chapter.chapterId"><view class="u-page-title">{{chapter.title}}</view><video id="myVideo" class="u-video" :src="chapter.chapterVideo" :initial-time="position" controls @play="play" @pause="pause" @ended="ended" @timeupdate="timeupdate" @error="videoError"/><text class="m-muted">{{completed?'已完成':'未完成'}}</text><view v-if="mediaError" class="u-state"><text>视频无法加载，请检查资源或网络</text><button class="m-small-button" @click="retryVideo">重试播放</button></view><rich-text :nodes="html"/><view v-if="pending" class="u-state"><text>学习记录待同步</text><button class="m-small-button" @click="retrySync">重试同步</button></view></template></view></template>
<script>
import {chapterData,htmlForPhone,reportLearning,touchChapter,flushReports} from '@/utils/learning';import {readLocal,saveLocal} from '@/utils/session';
export default {data:()=>({chapter:{},user:{},options:{},completed:false,position:0,html:'',error:'',mediaError:false,pending:false,started:0,seconds:0,completionQueued:false}),onLoad(options){this.options=options;this.load()},onHide(){this.capture();this.submit(false)},onUnload(){this.capture();this.submit(false)},methods:{async load(){this.error='';try{const data=await chapterData(this.options);this.chapter=data.chapter;this.user=data.user;this.completed=data.completed;this.html=htmlForPhone(this.chapter.content);this.position=readLocal('video:'+this.chapter.chapterId,0);touchChapter(this.chapter)}catch(e){this.error=e.message||'章节加载失败'}},play(){if(!this.started)this.started=Date.now()},capture(){if(this.started){this.seconds+=(Date.now()-this.started)/1000;this.started=0}},pause(){this.capture();this.submit(false)},timeupdate(e){this.position=e.detail.currentTime;saveLocal('video:'+this.chapter.chapterId,this.position)},videoError(){this.capture();this.mediaError=true;this.submit(false)},retryVideo(){this.mediaError=false;uni.createVideoContext('myVideo',this).play()},ended(){this.capture();this.submit(true)},submit(finished){if(!this.chapter.chapterId||this.completionQueued)return;const seconds=Math.floor(this.seconds);if(!finished&&seconds<=0)return;this.seconds-=seconds;if(finished)this.completionQueued=true;reportLearning({class_id:this.chapter.classId,chapter_id:this.chapter.chapterId,user_id:this.user.id,if_learned:finished||this.completed?1:0,learn_duration:seconds}).then(()=>{if(finished)this.completed=true;this.pending=false}).catch(()=>{this.pending=true})},async retrySync(){try{await flushReports();this.pending=false;const data=await chapterData(this.options);this.completed=data.completed}catch(e){this.pending=true}}}}
</script>