<template>
	<view>
		<view style="width: 90%; margin-left: 5%; font-size: 35rpx; height:112rpx; line-height: 112rpx;">积极分子</view>
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">姓名</view>
			</view>	
			<input style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="name" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">学号</view>
			</view>	
			<input style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="Id" />	
		</view>	
		<view>
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
					<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
					<view style="line-height: 84rpx; font-weight: bold;">所属支部</view>
				</view>		
				<view style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" >
					<picker style="width: 100%;" @change="partyChange" :value="branch_index" :range="branches" v-model="branch_value">
						<view style="display: flex; flex-direction: row; width: 100%; height: 84rpx;">{{branches[branch_index]}}
							<image src="/static/icons/down-gray.png" style="margin-left: 1%; margin-top: 21rpx; width: 5%; height: 42rpx;"></image>
						</view>
					</picker>
				</view>
			</view>
		</view>		
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">角色</view>
			</view>	
			<view style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;">{{roleValue}}</view>
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">岗位</view>
			</view>	
			<input style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="post" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">手机号</view>
			</view>	
			<input style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="phone" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">部门</view>
			</view>	
			<input style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="demartment" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 84rpx; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">年级</view>
			</view>	
			<input style="width: 60%; height: 84rpx; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="grade" />	
		</view>	
		<view class="photo">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 84rpx; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; line-height: 84rpx; font-weight: bold;">上传头像</view>
			</view>
			<view style="margin-left: 5%;">
				<uni-file-picker
				v-model="Value" 
				fileMediatype="image"  
				limit="1" 
				@progress="onProgress"
				@success="onSuccess"
				@fail="onFail"
				@select="onSelect"
				></uni-file-picker>
			</view>
			<view style="height: 42rpx;"></view>
		</view>
		
		<button class="btn" @click="addMember()">提交录入</button>
	</view>
</template>

<script>
import { addUser,getBranches,getBranches2 } from '@/api/api.js'
import { getBase_url } from '@/api/index.js'
export default {
	data() {
		return {
			name: '',
			phone: '',
			demartment: '',
			grade: '',
			Id: '',
			branches: [],
			branch_index: 0,
			branch_value: '',
			imageUrl: '',
			post: '',
			roleValue: '积极分子', // 默认角色为积极分子
		}
	},
	onLoad() {
		// 获取支部列表
		getBranches2().then(res => {
			console.log(res)
		    this.branches = res.map(branch => {
		      return branch.authority === 1 ? branch.branchName : null;
		    }).filter(branchName => branchName !== null);
			console.log(this.branches)
			this.branch_value = this.branches[this.branch_index]
		}).catch(error => {
		    console.error('获取支部列表失败:', error);
		});	
	},
	methods: {
		partyChange: function(event) {
			this.branch_index = event.detail.value;
			this.branch_value = this.branches[this.branch_index]
		},
		onProgress(event) {
			console.log('process')
		},
		onSuccess(res) {
			console.log('success')
		},
		onFail(err) {
			console.log('fail')
		},
		onSelect(res) {
			console.log(res.tempFilePaths[0])
			this.imageUrl = res.tempFilePaths[0]
		},
		addMember() {
			// 表单验证
			if (this.name === '') {
				uni.showToast({
					title: '姓名不能为空',
					icon: 'error',
					duration: 1000
				})
			} else if (this.Id === '') {
				uni.showToast({
					title: '学号不能为空',
					icon: 'error',
					duration: 1000
				})
			} else if (this.phone === '') {
				uni.showToast({
					title: '手机号不能为空',
					icon: 'error',
					duration: 1000
				})
			} else if (this.demartment === '') {
				uni.showToast({
					title: '部门不能为空',
					icon: 'error',
					duration: 1000
				})
			} else if (this.grade === '') {
				uni.showToast({
					title: '年级不能为空',
					icon: 'error',
					duration: 1000
				})
			} else {
				// 准备要发送的数据
				var data = {
					name: this.name,
					job_id: this.Id,
					branch_id: this.$store.getters.getBranchId(this.branch_value),
					role: this.roleValue,
					phone: this.phone,
					post: this.post,
					department: this.demartment,
					grade: this.grade,
				}
				console.log(data)
				// 如果没有上传头像
				if (this.imageUrl === '') {
					addUser(data).then((res) => {
						console.log(res)
						if (res === '添加用户失败，学工号已存在') {
							uni.showToast({
								title: res,
								icon: 'none'
							})
						} else {
							uni.showToast({
								title: '添加成功',
								icon: 'none'
							})
							setTimeout(() => {
								uni.navigateBack()
							}, 1000)
						}
					})
				} else {
					// 上传头像文件
					uni.uploadFile({
						url: getBase_url() + 'user/addUser',
						filePath: this.imageUrl,
						name: 'portrait',
						formData: {
							name: this.name,
							job_id: this.Id,
							post: this.post,
							branch_id: this.$store.getters.getBranchId(this.branch_value),
							role: this.roleValue,
							phone: this.phone,
							department: this.demartment,
							grade: this.grade,
						},
						header: {
							'Authorization': uni.getStorageSync('token') || '',
							'Content-Type': 'multipart/form-data' // 指定内容类型为 multipart/form-data
						},
						success: (res) => {
							console.log(res)
							if (res.data === '添加用户失败，学工号已存在') {
								uni.showToast({
									title: res,
									icon: 'none'
								})
							} else {
								uni.showToast({
									title: '添加成功',
									icon: 'none'
								})
								setTimeout(() => {
									uni.navigateBack()
								}, 1000)
							}
						},
						fail: (err) => {
							uni.showToast({
								title: '添加用户失败',
								icon: 'none'
							})
							console.error(err)
						},
					})
				}
			}
		}

	}
}

</script>

<style>
.btn{
	width: 100%; 
	height: 98rpx; 
	margin-top: 98rpx;
	background-color: #fc4c34; 
	color: white; 
	text-align: center; 
	position: fixed; 
	bottom: 0;
}
</style>