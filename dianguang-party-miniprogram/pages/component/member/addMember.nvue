<template>
	<view>
		<view style="width: 90%; margin-left: 5%; font-size: 35rpx; height:8vh; line-height: 112rpx;">党员信息</view>
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">姓名</view>
			</view>	
			<input style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="name" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">学号</view>
			</view>	
			<input style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="Id" />	
		</view>	
		<view v-if="roleValue !== '积极分子'">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
					<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
					<view style="line-height: 84rpx; font-weight: bold;">所属支部</view>
				</view>		
				<view style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" >
					<picker style="width: 100%;" @change="partyChange" :value="party_index" :range="party" v-model="partyValue">
						<view style="display: flex; flex-direction: row; width: 100%; height: 6vh;">{{party[party_index]}}
							<image src="/static/manager/home/下.svg" style="margin-left: 1%; margin-top: 21rpx; width: 5%; height: 3vh;"></image>
						</view>
					</picker>
				</view>
			</view>
		</view>		
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">角色</view>
			</view>	
			<view style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" >
				<picker style="width: 100%;" @change="roleChange" :value="role_index" :range="role" v-model="roleValue">
					<view style="display: flex; flex-direction: row; width: 100%; height: 6vh;">{{role[role_index]}}
						<image src="/static/manager/home/下.svg" style="margin-left: 1%; margin-top: 21rpx; width: 5%; height: 3vh;"></image>
					</view>
				</picker>
			</view>
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">岗位</view>
			</view>	
			<input style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="post" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">手机号</view>
			</view>	
			<input style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="phone" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">部门</view>
			</view>	
			<input style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="demartment" />	
		</view>	
		<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
			<view style="width: 20%; margin-left: 2.5%; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">年级</view>
			</view>	
			<input style="width: 60%; height: 6vh; line-height: 84rpx; margin-left: 10%;" placeholder="请输入" type="text" v-model="grade" />	
		</view>	
		<view class="photo">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; margin-top: 14rpx; height: 6vh; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; line-height: 84rpx; font-weight: bold;">上传头像</view>
			</view>
			<view style="margin-left: 5%;">
				<uni-file-picker
				v-model="Value" 
				fileMediatype="image"  
				limit="1" 
				@progress="onProgress"
				@success="onSuccess"
				@fail="onFail"
				@select="onSelect"
				></uni-file-picker>
			</view>
			<view style="height: 3vh;"></view>
		</view>
		
		<button class="btn" @click="addMember()">提交录入</button>
	</view>
</template>

<script>
	import { getBranches, addUser } from '@/api/api.js'
	import { getBase_url } from '@/api/index.js'
	export default {
		data(){
			return{
				name: '',
				phone: '',
				demartment: '',
				grade: '',
				role_index: 0,
				role: ["党员","预备党员"],
				post: '',
				roleValue: '党员',
				party_index: 0,
				party: [],
				partyValue: '',
				Id: '',
				imageUrl: '',
			}
		},
		onLoad() {
			this.party = this.$store.state.branchIdToName.map(item => item.branch_name).filter(branch_name => branch_name !== '积极分子支部');
			this.partyValue = this.party[this.party_index]
		},
		methods: {
			partyChange: function(event) {
				this.party_index = event.detail.value;
				this.partyValue = this.party[this.party_index]
			},
			roleChange: function(event) {
				this.role_index = event.detail.value;
				this.roleValue = this.role[this.role_index]
			},
			validatePhone(phone) {
				// 简单的手机号验证逻辑
				const phoneRegex = /^[1]([3-9])[0-9]{9}$/;
				return phoneRegex.test(phone);
			},
			validateId(Id) {
				// 学号验证，假设学号应该是数字
				const idRegex = /^[0-9]+$/;
				return idRegex.test(Id);
			},
			onProgress(event) {
				console.log('process')
			},
			onSuccess(res) {
				console.log('success')
			},
			onFail(err) {
				console.log('fail')
			},
			onSelect(res) {
				console.log(res.tempFilePaths[0])
				this.imageUrl = res.tempFilePaths[0]
			},
			addMember(){
				if (this.name === ''){
					uni.showToast({
						title: '姓名不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else if (this.Id === '' || !this.validateId(this.Id)) {
					uni.showToast({
						title: '无效的学号',
						icon: 'error',
						duration: 1000
					})
				}
				else if (this.post === '') {
					uni.showToast({
						title: '岗位不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else if (this.phone === '' || !this.validatePhone(this.phone)) {
					uni.showToast({
						title: '请输入有效的手机号',
						icon:'none',
						duration: 1000
					})
				}
				else if (this.demartment === '') {
					uni.showToast({
						title: '部门不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else if (this.grade === '') {
					uni.showToast({
						title: '年级不能为空',
						icon: 'error',
						duration: 1000
					})
				}
				else{
					var data = {
						name: this.name,
						job_id: this.Id,
						branch_id: this.$store.getters.getBranchId(this.partyValue),
						role: this.roleValue,
						phone: this.phone,
						post: this.post,
						department: this.demartment,
						grade: this.grade,
					}
					if (this.imageUrl === ''){
						addUser(data).then((res)=>{
							console.log(res)
							if (res === '添加用户失败，学工号已存在'){
								uni.showToast({
									title: res,
									icon: 'none'
								})	
							}
							else{
								uni.showToast({
									title: res,
									icon: 'none'
								})	
								setTimeout(() => {
									uni.navigateBack() 
								}, 1000);	
							}		
						})
					}
					else{
						uni.uploadFile({
							url: getBase_url() + 'user/addUser',
							filePath: this.imageUrl,
							name: 'portrait',
							formData: {
								name: this.name,
								job_id: this.Id,
								branch_id: this.$store.getters.getBranchId(this.partyValue),
								role: this.roleValue,
								phone: this.phone,
								post: this.post,
								department: this.demartment,
								grade: this.grade,
							}, 
							header:{
								'Authorization': uni.getStorageSync('token') || '',
								'Content-Type': 'multipart/form-data' // 指定内容类型为 multipart/form-data
							},		
							success: (res) => {
								console.log(res)
								if (res.data === '添加用户失败，学工号已存在'){
									uni.showToast({
										title: res,
										icon: 'none'
									})	
								}
								else{
									uni.showToast({
										title: res.data,
										icon: 'none'
									})	
									setTimeout(() => {
										uni.navigateBack() 
									}, 1000);	
								}				
							},
							fail: (err) => {
								uni.showToast({
									title: '添加用户失败',
									icon: 'none'
								})
								console.error(err);
							},
						});	
					}
				}
			}
		}
	}
</script>

<style>
.btn{
	width: 100%; 
	height: 7vh; 
	margin-top: 98rpx;
	background-color: #fc4c34; 
	color: white; 
	text-align: center; 
	position: fixed; 
	bottom: 0;
}
</style>
