	width: 20%; /* 保证选择按钮不会太宽 */
	height: 5vh;
	background-color: #377f7f;
	color: white;
	font-size: 22.4rpx;
	border-radius: 5px;
	margin-left: 10px; /* 给按钮与输入框之间留点间距 */
