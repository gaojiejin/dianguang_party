		<!-- 支部简介 -->
		<view class="brief">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">支部简介</view>	
			</view>		
			<view class="textarea-container">
				<textarea
				    class="textarea-field"
				    placeholder="请输入支部简介"
					v-model="inputBrief"
					maxlength="-1"
				/>
			</view>
		</view>

		<!-- 新建支部按钮 -->
		<button class="btn" @click="addParty">新建支部</button>
	</view>
</template>

<script>
	import {addBranch} from '@/api/api.js'
import { data } from 'uview-ui/libs/mixin/mixin';
	export default {
		data() {
			return {
				partyTitle: '',
				partySecretary: '', // 用于显示选择的书记姓名
				inputBrief: '',
				department: '',
				user: '',
				index: 0,
				partyType: '党员支部',
				partyList: ['党员支部', '积极分子支部']
				
			};
		},
		onLoad() {
			// 获取选择的书记信息
			const eventChannel = this.getOpenerEventChannel();
			eventChannel.on('selectSecretary', (data) => {
				this.partySecretary = data.name; // 获取并设置选中的书记名字
				this.user = data
			});
		},
		methods: {
			bindPickerChange: function(event) {
				this.index = event.detail.value
				this.partyType = this.partyList[this.index]
			},
			// 添加支部
			addParty() {
				if (this.partyTitle === '') {
					uni.showToast({
						title: '支部名称不能为空',
						icon: 'error',
						duration: 1000
					});
				}
				else if (this.department === ''){
					uni.showToast({
						title: '部门不能为空',
						icon: 'error',
						duration: 1000
					});
				}
				else if (this.inputBrief === '') {
					uni.showToast({
						title: '支部简介不能为空',
						icon: 'error',
						duration: 1000
					});
				} 
				else {
					var data = {
						branchName: this.partyTitle,
						branchDis: this.inputBrief,
						department: this.department,
						branchType: this.partyType,
					}
					addBranch(data).then((res)=>{
						console.log(res)
						if (res === '支部添加成功'){
							uni.showToast({
								title: '添加支部成功',
								icon: 'none'
							})	
							setTimeout(() => {
								uni.navigateBack();
							}, 1000);	
						}
						else{
							uni.showToast({
								title: res,
								icon: 'none'
							})	
						}
					})
				}
			},
			// 跳转到选择支部书记页面
			selectSecretary() {
				uni.navigateTo({
					url: '/pages/component/party/selectMember',
					events: {
						// 接收来自 selectMember 页面选择的书记数据
						selectSecretary: (data) => {
							this.partySecretary = data.name; // 获取书记的名字
							this.user = data; // 获取完整的用户信息
							console.log(this.user);
						},
					}
				});
			}

		}
	};
</script>

