<template>
	<view>
		<view class="title">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">支部名称</view>
				<input style="width: 85%; height: 6vh; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入标题" type="text" v-model="partyTitle" />	
			</view>		
		</view>
		<view class="title">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row; border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="line-height: 84rpx; font-weight: bold;">支部部门</view>
				<input style="width: 85%; height: 6vh; text-align: right; line-height: 84rpx; margin-right: 2.5%;" placeholder="请输入部门" type="text" v-model="department" />	
			</view>		
		</view>
		<view class="classify">
			<view style="width: 95%; margin-left: 2.5%; margin-right: 2.5%; height: 6vh; display: flex; flex-direction: row;  border-bottom: 1px solid #abbedb;">
				<view style="margin-left: 2.5%; color: red; line-height: 84rpx;">*</view>
				<view style="width: 40%; line-height: 84rpx; font-weight: bold;">支部分类</view>
				<view style="width: 55%; height: 6vh; text-align: right; line-height: 84rpx; margin-right: 2.5%; display: flex; flex-direction: row;">
					<picker @change="bindPickerChange" :value="index" :range="partyList" v-model="partyType" style="width: 100%;">
						<view style="text-align: right; margin-right: 2.5%;" >{{partyList[index]}}</view>
					</picker>	
				</view>
			</view>		
		</view>
		
