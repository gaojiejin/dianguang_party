<template><view class="m-page"><view class="u-page-title">学习</view><view class="u-study-stats"><view><text class="u-number">{{finished}}</text><text>已完成</text></view><view><text class="u-number">{{courses.length-finished}}</text><text>待学习</text></view><view><text class="u-number">{{courses.length}}</text><text>应学课程</text></view></view><button v-if="courses.length" class="u-continue" @click="continueLearning">继续学习 <text>›</text></button><view class="m-search"><input v-model="keyword" placeholder="搜索课程名称"/></view><view class="m-tabs"><view v-for="(name,index) in filters" :key="index" :class="['m-tab',status===index?'m-tab-active':'']" @click="status=index">{{name}}</view></view><view v-if="loading" class="m-empty">加载中…</view><view v-else-if="error" class="u-state"><text>课程加载失败</text><button class="m-small-button" @click="load">重新加载</button></view><view v-else-if="!visibleCourses.length" class="m-empty">{{keyword?'没有找到相关课程':'暂无相关课程'}}</view><view v-for="course in visibleCourses" :key="course.classId" class="m-course" @click="openCourse(course.classId)"><image v-if="course.classPortrait && !broken[course.classId]" :src="course.classPortrait" mode="aspectFill" @error="markBroken(course.classId)"/><view v-else class="m-course-icon">学</view><view class="m-course-copy"><text class="m-heading">{{course.classTitle}}</text><text class="m-muted">{{course.finished}} / {{course.total}} 节 · {{course.completed?'已完成':'未完成'}}</text></view><text class="m-course-arrow">›</text></view><userTabbar :managerValue="1"/></view></template>
<script>
import request from '@/api/index';import userTabbar from '@/component/userTabbar.vue';import {readLocal} from '@/utils/session';import {flushReports,chapterUrl} from '@/utils/learning';
export default {components:{userTabbar},data:()=>({courses:[],keyword:'',status:0,filters:['全部','未完成','已完成'],loading:false,error:false,broken:{}}),computed:{finished(){return this.courses.filter(c=>c.completed).length},visibleCourses(){return this.courses.filter(c=>(!this.keyword||(c.classTitle||'').includes(this.keyword))&&(this.status===0||(this.status===1?!c.completed:c.completed)))}},onShow(){this.load()},onPullDownRefresh(){this.load().finally(()=>uni.stopPullDownRefresh())},methods:{markBroken(id){this.$set(this.broken,id,true)},async load(){if(this.loading)return;this.loading=true;this.error=false;try{try{await flushReports()}catch(e){}const user=this.$store.state.user;const data=await Promise.all([request({url:'class/getClasses',method:'POST'}),request({url:'learning/course-progress',data:{user_id:user.id}})]);const map={};(data[1]||[]).forEach(x=>{map[x.classId]=x});const authority=user.role==='积极分子'?1:0;this.courses=(data[0]||[]).filter(c=>Number(c.authority)===authority).map(c=>({...c,...(map[c.classId]||{total:0,finished:0,completed:false})})).sort((a,b)=>b.classId-a.classId)}catch(e){this.error=true}finally{this.loading=false}},openCourse(id){uni.navigateTo({url:'/pages/user/learn/learnDetail?class_id='+id})},async continueLearning(){try{const recent=readLocal('recent',null);const course=this.courses.find(c=>recent&&c.classId===recent.courseId&&!c.completed)||this.courses.find(c=>!c.completed);if(!course)return uni.showToast({title:'当前课程均已完成',icon:'none'});const detail=await request({url:'learnRate/getUserLearnDetail',method:'POST',data:{class_id:course.classId,user_id:this.$store.state.user.id}});let index=(detail.chapterList||[]).findIndex((c,i)=>recent&&c.chapterId===recent.chapterId&&!detail.chapterIfLearnedList[i]);if(index<0)index=(detail.chapterList||[]).findIndex((c,i)=>!detail.chapterIfLearnedList[i]);if(index<0)return this.openCourse(course.classId);uni.navigateTo({url:chapterUrl(course.classId,detail.chapterList[index])})}catch(e){}}}}
</script>