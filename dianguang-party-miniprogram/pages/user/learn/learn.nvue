<template>
 <view class="m-page r-original r-learning">
  <view class="r-study-summary"><view class="r-study-circle"><view class="r-progress-ring"><text class="r-progress-value">{{courses.length?Math.round(finished*100/courses.length):0}}%</text><text class="r-progress-label">课程完成率</text></view></view><view class="r-study-copy"><text class="r-study-name">{{$store.state.user.name || '学习统计'}}</text><view class="r-study-line"><text class="r-dot r-blue"/><text>总课程</text><text>{{courses.length}} 门</text></view><view class="r-study-line"><text class="r-dot r-gray"/><text>未完成</text><text>{{courses.length-finished}} 门</text></view><view class="r-study-line"><text class="r-dot r-green"/><text>已完成</text><text>{{finished}} 门</text></view></view></view>
  <view class="m-search"><party-icon type="search" size="20" color="#8998ad"/><input v-model="keyword" placeholder="搜索课程名称"/></view>
  <view class="r-learning-tabs"><view class="r-category r-selected">{{$store.state.user.role==='积极分子'?'积极分子课程':'党员课程'}}</view><button v-if="courses.length" class="r-continue" @click="continueLearning">继续学习 <text>›</text></button></view>
  <view class="m-tabs"><view v-for="(name,index) in filters" :key="index" :class="['m-tab',status===index?'m-tab-active':'']" @click="status=index">{{name}}</view></view>
  <view v-if="loading" class="m-empty">加载中…</view><view v-else-if="error" class="u-state"><text>课程加载失败</text><button class="m-small-button" @click="load">重新加载</button></view><view v-else-if="!visibleCourses.length" class="m-empty">{{keyword?'没有找到相关课程':'暂无相关课程'}}</view>
  <view v-for="course in visibleCourses" :key="course.classId" class="r-course-card" @click="openCourse(course.classId)"><view class="r-course-body"><image v-if="course.classPortrait&&!broken[course.classId]" :src="course.classPortrait" mode="aspectFill" class="r-course-cover" @error="markBroken(course.classId)"/><view v-else class="r-course-cover r-cover-placeholder"><party-icon type="list" size="30" color="#C91010"/></view><view class="m-course-copy"><text class="m-heading">{{course.classTitle}}</text><text class="m-muted">{{course.department}}</text><text class="m-muted">{{course.finished}} / {{course.total}} 节 · {{course.completed?'已完成':'未完成'}}</text></view><party-icon type="right" size="18" color="#9ea9b7"/></view><view class="r-course-meta"><text>南京理工大学</text><text>发布人：{{course.founder}}</text><text>{{course.uploadTime?course.uploadTime.split('T')[0]:''}}</text></view></view>
  <userTabbar :managerValue="1"/>
 </view>
</template>
<script>
import request from '@/api/index';import userTabbar from '@/component/userTabbar.vue';import {readLocal} from '@/utils/session';import {flushReports,chapterUrl} from '@/utils/learning';
export default {components:{userTabbar},data:()=>({screenWidth:uni.getSystemInfoSync().windowWidth,courses:[],keyword:'',status:0,filters:['全部','未完成','已完成'],loading:false,error:false,broken:{}}),computed:{progressSize(){return Math.min(144,Math.floor(this.screenWidth*.32))},finished(){return this.courses.filter(c=>c.completed).length},visibleCourses(){return this.courses.filter(c=>(!this.keyword||(c.classTitle||'').includes(this.keyword))&&(this.status===0||(this.status===1?!c.completed:c.completed)))}},onResize(e){this.screenWidth=e.size.windowWidth},onShow(){this.load()},onPullDownRefresh(){this.load().finally(()=>uni.stopPullDownRefresh())},methods:{markBroken(id){this.$set(this.broken,id,true)},async load(){if(this.loading)return;this.loading=true;this.error=false;try{try{await flushReports()}catch(e){}const user=this.$store.state.user;const data=await Promise.all([request({url:'class/getClasses',method:'POST'}),request({url:'learning/course-progress',data:{user_id:user.id}})]);const map={};(data[1]||[]).forEach(x=>{map[x.classId]=x});const authority=user.role==='积极分子'?1:0;this.courses=(data[0]||[]).filter(c=>Number(c.authority)===authority).map(c=>({...c,...(map[c.classId]||{total:0,finished:0,completed:false})})).sort((a,b)=>b.classId-a.classId)}catch(e){this.error=true}finally{this.loading=false}},openCourse(id){uni.navigateTo({url:'/pages/user/learn/learnDetail?class_id='+id})},async continueLearning(){try{const recent=readLocal('recent',null);const course=this.courses.find(c=>recent&&c.classId===recent.courseId&&!c.completed)||this.courses.find(c=>!c.completed);if(!course)return uni.showToast({title:'当前课程均已完成',icon:'none'});const detail=await request({url:'learnRate/getUserLearnDetail',method:'POST',data:{class_id:course.classId,user_id:this.$store.state.user.id}});let index=(detail.chapterList||[]).findIndex((c,i)=>recent&&c.chapterId===recent.chapterId&&!detail.chapterIfLearnedList[i]);if(index<0)index=(detail.chapterList||[]).findIndex((c,i)=>!detail.chapterIfLearnedList[i]);if(index<0)return this.openCourse(course.classId);uni.navigateTo({url:chapterUrl(course.classId,detail.chapterList[index])})}catch(e){}}}}
</script>
