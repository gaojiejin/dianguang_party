<template><view class="m-page"><view class="u-page-title">{{course.classTitle || '课程详情'}}</view><view v-if="loading" class="m-empty">加载中…</view><view v-else-if="error" class="u-state"><text>课程加载失败</text><button @click="load" class="m-small-button">重试</button></view><template v-else><view class="u-detail-progress"><text>已完成 {{completedCount}} / {{chapters.length}} 节</text><progress :percent="percent" activeColor="#b12b3e" stroke-width="5"/></view><view v-for="(item,index) in chapters" :key="item.chapterId" class="u-chapter" @click="open(item)"><view class="u-chapter-order">{{index+1}}</view><view class="m-course-copy"><text class="m-heading">{{item.title}}</text><text class="m-muted">{{item.type===1?'图文':item.type===2?'视频':'链接'}} · {{completed[index]?'已完成':'未完成'}}</text></view><text class="m-course-arrow">›</text></view><view v-if="!chapters.length" class="m-empty">暂无章节</view></template></view></template>
<script>
import request from '@/api/index';import {decodeLegacy} from '@/utils/session';import {chapterUrl,flushReports} from '@/utils/learning';
export default {data:()=>({id:0,course:{},chapters:[],completed:[],loading:false,error:false}),computed:{completedCount(){return this.completed.filter(Boolean).length},percent(){return this.chapters.length?Math.round(this.completedCount*100/this.chapters.length):0}},onLoad(options){this.id=Number(options.class_id||decodeLegacy(options.course).classId)},onShow(){this.load()},methods:{async load(){this.loading=true;this.error=false;try{try{await flushReports()}catch(e){}const data=await Promise.all([request({url:'class/getClassById',method:'POST',data:{class_id:this.id}}),request({url:'learnRate/getUserLearnDetail',method:'POST',data:{class_id:this.id,user_id:this.$store.state.user.id}})]);this.course=data[0];if(!this.course)throw new Error('课程不存在');const role=this.$store.state.user.role;if((role==='积极分子'?1:0)!==Number(this.course.authority))throw new Error('无权限学习该课程');this.chapters=data[1].chapterList||[];this.completed=(data[1].chapterIfLearnedList||[]).map(Boolean)}catch(e){this.error=true}finally{this.loading=false}},open(chapter){uni.navigateTo({url:chapterUrl(this.id,chapter)})}}}
</script>