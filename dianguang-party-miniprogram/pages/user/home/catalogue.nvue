<template>
	<view>
		<view style="height: 8vh; width: 100%; display: flex; flex-direction: row; border-bottom: 1px #abbedb solid; background-color: white;">
			<view style="width: 33%;">
				<view :class="[type === 0 ? 'on_nav' : 'nav']" @click="type = 0">时政要闻</view>
			</view>
			<view style="width: 33%;">
				<view :class="[type === 1 ? 'on_nav' : 'nav']" @click="type = 1">支部动态</view>
			</view>
			<view style="width: 33%;">
				<view :class="[type === 2 ? 'on_nav' : 'nav']" @click="type = 2">微课堂展示</view>
			</view>
		</view>
		<view style="margin-top: 14rpx;"></view>
		<view>
			<view v-for="(item,index) in articles.length" :key="index" >
				<view v-if="list[type] === articles[item].type">
					<myTable :article="articles[item]"></myTable>
				</view>
			</view> 
		</view>
	</view>
	
</template>

<script>
	import myTable from '@/component/myTable.vue'
	export default {
		components: {
			myTable
		},
		data() {
			return {
				type: null,
				list: ['时政要闻', '支部动态', '微课堂展示'],
				articles: [],
			}
		},
		onLoad(options) {
			this.type = parseInt(options.index, 10); 
			this.articles = JSON.parse(decodeURIComponent(options.articles));
		},
		methods: {
			renderIndex() {
			  console.log(this.type);
			  console.log(this.articles)
			}
		},
		mounted() {
		    this.renderIndex();
		}
	}
</script>

