<template>
	<view class="home-page">
		<!-- 添加 Tab 栏 -->
		<view class="tab-bar">
			<view v-for="(tab, index) in tabs" :key="index" class="tab" :class="{ active: currentTab === index }" @click="changeTab(index)">
				{{ tab.title }}
			</view>
		</view>

		<uni-swiper-dot class="uni-swiper-dot-box" @clickItem="clickItem" :info="swipers" :current="current" :mode="mode"
			:dots-styles="dotsStyles" field="content">
			<swiper class="swiper-box" @change="change" :current="swiperDotIndex" :autoplay="autoplay" :interval="interval" :circular="circular">
				<swiper-item v-for="(item, index) in swipers" :key="index">
					<view class="swiper-item" :class="'swiper-item' + index">
						<image :src="item.url" mode="aspectFit" class="banner-image"></image>
					</view>
				</swiper-item>
			</swiper>
		</uni-swiper-dot>


		<view v-if="role === '支部管理员'" style="height: 210rpx; width: 100%; display: flex; flex-direction: row; background-color: white; overflow-x: auto;">
			<view v-for="(item, index) in content" :key="index" @click="ToPage(index)" style="width: 20%;">
				<view style="height: 112rpx; width: 70%; margin-left: 15%; margin-top: 28rpx; border-radius: 50%; background-color: #e2544a;">
					<image :src="item.url" style="width: 60%; margin-left: 20%; margin-top: 14rpx; height: 84rpx;"></image>
				</view>
				<view style="font-size: 28rpx; line-height: 42rpx; text-align: center; margin-top: 14rpx;">{{item.title}}</view>
			</view>
		</view>

        <view class="feed-search"><uni-search-bar :key="currentTab" :value="keyword" :placeholder="'搜索'+tabs[currentTab].title+'标题'" cancelButton="none" @input="onSearchInput" @confirm="searchNow" @clear="clearSearch"/></view>
        <view class="feed-list">
            <view v-if="loading" class="feed-state">加载中…</view>
            <view v-else-if="loadError" class="feed-state"><text>加载失败</text><text class="feed-retry" @click="fetchArticles">重新加载</text></view>
            <view v-else-if="!filteredArticles.length" class="feed-state">{{keyword.trim()?'未找到相关内容':'暂无内容'}}</view>
            <homeArticle v-for="item in filteredArticles" v-else :key="item.articleId" :article="item"/>
            <view v-if="totalItems>0&&!loadError" class="feed-pagination"><uni-pagination :show-icon="true" :total="totalItems" :page-size="5" :current="currentPage" @change="onPageChange"/></view>
        </view>

		<view style="height: 42rpx;"></view>
		<userTabbar :managerValue="currentValue" style="height: 42rpx; margin-top: 42rpx;"></userTabbar>
	</view>
</template>

<script>
	import homeArticle from '@/component/homeArticle.vue'
    import request from '@/api/index.js'
	import userTabbar from '@/component/userTabbar.vue'
	import { queryIDNameMapping, getAllSwiper } from '@/api/api.js'

	export default {
		components: {
			homeArticle,
			userTabbar
		},
		data() {
			return {
				currentValue: 0,
				tabs: [
					{ title: '时政要闻', type: '时政要闻' },
					{ title: '支部动态', type: '支部动态' },
					{ title: '微课堂展示', type: '微课堂展示' }
				],
				currentTab: 0,
				swipers: [],
				keyword: '', searches: ['', '', ''], loading: false, loadError: false, requestVersion: 0,
				filteredArticles: [],
				dotsStyles: {	
					backgroundColor: 'rgba(255, 90, 95,0.3)',
					border: '1px rgba(255, 90, 95,0.3) solid',
					color: '#fff',
					selectedBackgroundColor: 'rgba(255, 90, 95,0.9)',
					selectedBorder: '1px rgba(255, 90, 95,0.9) solid'
				},
				swiperDotIndex: 0,
				current: 0,
				mode: 'dot',
				autoplay: true,
				interval: 5000,
				circular: true,
				role: '',
				catalogue: [
					{ url: '/static/user/home/党建要闻.svg', title: '时政要闻' },
					{ url: '/static/user/home/党务公开.svg', title: '支部动态' },
					{ url: '/static/user/home/党内公示.svg', title: '微课堂展示' }
				],
				content: [
					{ url: '/static/manager/home/内容发布.svg', title: '内容发布' },
					{ url: '/static/manager/home/内容审核.svg', title: '内容审核' },
					{ url: '/static/manager/home/支部管理.svg', title: '支部管理' },
					{ url: '/static/manager/home/学习管理.svg', title: '学习管理' },
					{ url: '/static/manager/home/更多.svg', title: '更多内容' }
				],
				
				currentPage: 1, // 当前页码
				pageSize: 5,   // 每页条数
				totalItems: 0,  // 文章总数
			}
		},
		onLoad() {
			queryIDNameMapping().then((res) => {
				this.$store.state.branchIdToName = res;
			});
		},
		onShow() {
			getAllSwiper().then((res) => {
				this.swipers = res;
			});
			this.role = uni.getStorageSync('role');
			this.fetchArticles();
		},
        onHide(){clearTimeout(this.searchTimer); this.requestVersion++; this.loading=false},
        onUnload(){clearTimeout(this.searchTimer);this.requestVersion++},
        onPullDownRefresh(){this.currentPage=1;this.fetchArticles().finally(()=>uni.stopPullDownRefresh())},
        methods: {
            changeTab(index) {
                if(index===this.currentTab)return;
                clearTimeout(this.searchTimer);this.searches[this.currentTab]=this.keyword;
                this.currentTab=index;this.keyword=this.searches[index];this.currentPage=1;
                this.fetchArticles();
            },
            onSearchInput(event){
                this.keyword=typeof event==='string'?event:(event.value!==undefined?event.value:((event.detail&&event.detail.value)||''));
                this.requestVersion++;this.loading=true;this.filteredArticles=[];
                clearTimeout(this.searchTimer);this.searchTimer=setTimeout(()=>this.searchNow(),350);
            },
            clearSearch(){this.keyword='';this.searchNow()},
            searchNow(){clearTimeout(this.searchTimer);this.currentPage=1;this.searches[this.currentTab]=this.keyword;this.fetchArticles()},
            async fetchArticles(){
                const version=++this.requestVersion;
                this.loading=true;this.loadError=false;this.filteredArticles=[];
                try{
                    const result=await request({url:'article/passed-page',method:'GET',data:{type:this.tabs[this.currentTab].type,keyword:this.keyword.trim().slice(0,100),page:this.currentPage},silent:true});
                    if(version!==this.requestVersion)return;
                    this.filteredArticles=result.records||[];this.totalItems=result.total||0;this.currentPage=result.page||1;
                }catch(e){if(version===this.requestVersion){this.loadError=true;this.totalItems=0}}
                finally{if(version===this.requestVersion)this.loading=false}
            },
            onPageChange(event){this.currentPage=event.current;this.fetchArticles();uni.pageScrollTo({scrollTop:0,duration:150})},
			change(e) {
				this.current = e.detail.current;
			},
			clickItem(e) {
				this.swiperDotIndex = e;
			},
			ToPage(index) {
				if (index === 0) {
					uni.navigateTo({ url: `/pages/manager/home/contentPublish` });
				} else if (index === 1) {
					uni.navigateTo({ url: `/pages/manager/home/contentReview2` });
				} else if (index === 2) {
					uni.navigateTo({ url: `/pages/manager/home/partyManage2` });
				} else if (index === 3) {
					uni.navigateTo({ url: `/pages/manager/home/learnManage2` });
				} else {
					uni.showToast({
						title: '暂无更多内容',
						icon: 'none',
						duration: 1000
					});
				}
			},
		},
	}
</script>

<style lang="scss">
.home-page { padding-top:100rpx; padding-bottom:calc(120rpx + env(safe-area-inset-bottom)); }
.tab-bar { display:flex; flex-direction:row; position:fixed; top:0; left:0; right:0; z-index:100; min-height:100rpx; align-items:center; background:#f8f8f8; }
.tab { flex:1; min-width:0; padding:24rpx 6rpx; text-align:center; font-size:28rpx; line-height:1.6; border-bottom:4rpx solid transparent; }
.tab.active { font-weight:bold; color:#e2544a; border-bottom-color:#e2544a; }
.swiper-box, .swiper-item { height:320rpx; width:100%; background:#fff; }
.swiper-item { display:flex; flex-direction:column; justify-content:center; align-items:center; }
.banner-image { width:100%; height:100%; }
.feed-search { padding:16rpx 12rpx 4rpx; }
.feed-list { background:#fff; }
.feed-state { display:flex; flex-direction:row; justify-content:center; gap:24rpx; padding:70rpx 24rpx; font-size:27rpx; color:#999; }
.feed-retry { color:#e2544a; }
.feed-pagination { display:flex; flex-direction:row; justify-content:center; padding:30rpx 20rpx; }
</style>
