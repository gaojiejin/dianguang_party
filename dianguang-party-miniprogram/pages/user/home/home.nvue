<template><view class="m-page u-home"><view class="u-page-title">电光党建</view><swiper v-if="swipers.length" class="m-swiper" autoplay circular indicator-dots indicator-active-color="#b12b3e"><swiper-item v-for="item in swipers" :key="item.id"><image :src="item.url" mode="aspectFit" class="m-swiper-image" @error="imageError"/></swiper-item></swiper><view v-if="role==='支部管理员'" class="m-card"><text class="m-heading">支部管理</text><view class="m-shortcuts"><view v-for="(item,index) in shortcuts" :key="index" @click="openManage(index)"><text class="m-shortcut-symbol">{{item.title.slice(0,1)}}</text><text>{{item.title}}</text></view></view></view><view class="m-search"><input v-model="keyword" placeholder="搜索文章标题" @input="search"/></view><view class="m-tabs"><view v-for="(tab,index) in tabs" :key="index" :class="['m-tab',currentTab===index?'m-tab-active':'']" @click="changeTab(index)">{{tab}}</view></view><view v-if="loading" class="m-empty">加载中…</view><view v-else-if="error" class="u-state"><text>内容加载失败</text><button class="m-small-button" @click="load">重新加载</button></view><view v-else-if="!filtered.length" class="m-empty">{{keyword?'没有找到相关内容':'暂无内容'}}</view><myTable v-for="item in pageArticles" :key="item.articleId" :article="item"/><uni-pagination v-if="filtered.length>pageSize" :total="filtered.length" :page-size="pageSize" :current="page" @change="changePage"/><userTabbar :managerValue="0"/></view></template>
<script>
import request from '@/api/index';import myTable from '@/component/myTable.vue';import userTabbar from '@/component/userTabbar.vue';
export default {components:{myTable,userTabbar},data:()=>({swipers:[],articles:[],tabs:['时政要闻','支部动态','微课堂展示'],currentTab:1,keyword:'',page:1,pageSize:8,loading:false,error:false,role:'',shortcuts:[{title:'内容发布'},{title:'内容审核'},{title:'支部管理'},{title:'学习管理'}]}),computed:{filtered(){return this.articles.filter(a=>(a.type===this.tabs[this.currentTab]||(this.currentTab===2&&a.type==='链接展示'))&&(!this.keyword||(a.title||'').includes(this.keyword)))},pageArticles(){return this.filtered.slice((this.page-1)*this.pageSize,this.page*this.pageSize)}},onShow(){this.role=uni.getStorageSync('role');this.load()},onPullDownRefresh(){this.load().finally(()=>uni.stopPullDownRefresh())},methods:{async load(){if(this.loading)return;this.loading=true;this.error=false;try{const data=await Promise.all([request({url:'swiper/getAllSwiper',method:'POST'}),request({url:'article/queryArticlePassed',method:'POST'})]);this.swipers=data[0]||[];this.articles=(data[1]||[]).sort((a,b)=>new Date(b.uploadTime)-new Date(a.uploadTime));this.page=Math.min(this.page,Math.max(1,Math.ceil(this.filtered.length/this.pageSize)))}catch(e){this.error=true}finally{this.loading=false}},search(){this.page=1},changeTab(index){this.currentTab=index;this.page=1},changePage(e){this.page=e.current;uni.pageScrollTo({scrollTop:0,duration:150})},imageError(){},openManage(index){const pages=['contentPublish','contentReview2','partyManage2','learnManage2'];uni.navigateTo({url:'/pages/manager/home/'+pages[index]})}}}
</script>