<template>
	<view>
		<view style="height: 280rpx;">
			<image src="/static/icons/logo-red.png" style="height: 210rpx; width: 30%; margin-left: 35%; margin-top: 70rpx;"></image>
		</view>
		<view style="height: 140rpx; line-height: 140rpx; font-size: 30.8rpx; color: #abbedb; text-align: center;">
			忘记密码
		</view>
		<view style="width: 78%; margin-left: 11%;">
			<view class="login-account">
				<view style="width: 20%; text-align: left; height: 56rpx; line-height: 56rpx; font-size: 21rpx; display: flex; flex-direction: row;">
					+86
					<image src="/static/icons/down-gray.png" style="height: 56rpx; width: 40%; line-height: 56rpx;"></image>
					<view style="color: #abbedb;">|</view>
				</view>
				<input placeholder-class="placeholder_class" type="text" placeholder="请输入手机号" v-model="phone"
				 style="width: 50%; height: 56rpx; line-height: 56rpx; font-size: 28rpx;;"/>
				 <view style="width: 35%;">
					 <button v-if="sixty==0" class="getCode" @click="getCode()">获取验证码</button>
					 <button v-else class="getCode">获取验证码 {{sixty}}</button>
				 </view>
			</view>
			<view class="login-password">
				<view style="width: 20%; text-align: left; line-height: 56rpx; height: 56rpx; font-size: 21rpx;">验证码</view>
				<input placeholder-class="placeholder_class" type="text" placeholder="请输入验证码" v-model="code"
				 style="width: 80%; height: 56rpx; line-height: 56rpx; font-size: 28rpx;" />
			</view>
			<view class="login-password">
				<view style="width: 20%; text-align: left; line-height: 56rpx; height: 56rpx; font-size: 21rpx;">新密码</view>
				<input placeholder-class="placeholder_class" :type="Pwd_type1" placeholder="请输入新密码" v-model="password"
				 style="width: 65%; height: 56rpx; line-height: 56rpx; font-size: 28rpx;" />
				<view v-if="Pwd_type1 === 'password'" style="width: 15%;">
					<image class="eye" src="/static/icons/eyeoff-gray.png" @click="Pwd_type1 = 'text'"></image>
				</view>
				<view v-else style="width: 15%;">
					<image class="eye" src="/static/icons/eye-gray.png" @click="Pwd_type1 = 'password'"></image>
				</view>
			</view>
			<view class="login-password">
				<view style="width: 20%; text-align: left; line-height: 56rpx; height: 56rpx; font-size: 21rpx;">确认密码</view>
				<input placeholder-class="placeholder_class" :type="Pwd_type2" placeholder="请再次输入新密码" v-model="password_again"
				 style="width: 65%; height: 56rpx; line-height: 56rpx; font-size: 28rpx;" />
				 <view v-if="Pwd_type2 === 'password'" style="width: 15%;">
				 	<image class="eye" src="/static/icons/eyeoff-gray.png" @click="Pwd_type2 = 'text'"></image>
				 </view>
				 <view v-else style="width: 15%;">
				 	<image class="eye" src="/static/icons/eye-gray.png" @click="Pwd_type2 = 'password'"></image>
				 </view>
			</view>
			<view>
				<button class="login-button" style="margin-top: 70rpx;" @click="changePwd()">修改密码</button>
			</view>
		</view>
	</view>
</template>

<script>
	export default {
		data () {
			return {			
				phone: '',
				code:'',
				password: '',
				password_again: '',
				Pwd_type1: 'password',
				Pwd_type2: 'password',
				sixty: 0,
			}
		},
		methods: {
			getCode(){
				console.log('code')	
				this.sixty = 60
				this.countTime()
			},
			countTime() {
				let that = this;
				var timer = setInterval(function() {
					that.sixty -= 1;
					if (that.sixty == 0) {
						clearInterval(timer);
					}
				}, 1000);
			},
			changePwd(){
				console.log('修改密码')
			}
		}
	}
</script>

