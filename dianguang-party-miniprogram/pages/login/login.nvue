<template>
 <view class="r-original r-login"><view class="r-login-brand"><image class="r-brand-logo" src="/static/icons/logo-red.png" mode="aspectFit"/><text class="r-brand-title">电光党建</text></view>
 <view class="r-login-tabs"><text class="r-login-selected">密码登录</text><text @click="showSms">验证码登录</text></view>
 <view class="r-login-form"><view class="r-login-field"><party-icon type="person" size="24" color="#94a7c0"/><input v-model.trim="account" placeholder="请输入账号" maxlength="40" confirm-type="next"/></view><view class="r-login-field"><party-icon type="locked" size="24" color="#94a7c0"/><input v-model="password" password placeholder="请输入密码" @confirm="Login" confirm-type="done"/></view><view class="r-login-help"><text @click="forgot">忘记密码</text></view><button class="r-login-button" :loading="busy" :disabled="busy" @click="Login">登录</button><text v-if="error" class="u-error">{{error}}</text></view>
 </view>
</template>
<script>
import request from '@/api/index';import {flushReports} from '@/utils/learning';
export default {data:()=>({account:'',password:'',busy:false,error:''}),methods:{async Login(){if(this.busy)return;if(!this.account||!this.password)return uni.showToast({title:'请输入账号和密码',icon:'none'});this.busy=true;this.error='';try{const login=await request({url:'login/jobIDLogin',method:'POST',data:{job_id:this.account,password:this.password},silent:true});if(!login||!login.token)throw new Error(typeof login==='string'?login:'登录失败');uni.setStorageSync('token',login.token);uni.setStorageSync('job_id',this.account);const user=await request({url:'user/queryByJobID',data:{job_id:this.account}});if(!user||!user.id)throw new Error('用户信息获取失败');const safe={...user};delete safe.password;uni.setStorageSync('user',safe);uni.setStorageSync('role',user.role);uni.setStorageSync('phone',user.phone||'');Object.assign(this.$store.state,{user:safe,token:login.token,job_id:this.account,role:user.role,phone:user.phone});try{this.$store.state.branchIdToName=await request({url:'branch/queryIDNameMapping'})}catch(e){}flushReports().catch(()=>{});uni.switchTab({url:user.role==='超级管理员'?'/pages/manager/home/home':'/pages/user/home/home'})}catch(e){this.error=e.message||'登录失败，请重试'}finally{this.busy=false}},showSms(){uni.showModal({title:'验证码登录',content:'本地环境未接入短信服务，请使用账号密码登录。',showCancel:false})},forgot(){uni.showModal({title:'找回密码',content:'本地环境未接入短信服务，请联系管理员重置密码。',showCancel:false})}}}
</script>
